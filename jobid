 {\n      return {\n        available: [],\n        disable: [],\n        is_initial_with_position: isInitialWithPosition\n      };\n    }\n\n    const vpsPositions = sourcePositions.filter(\n      (position) => !position.type || position.type === PositionTypeEnum.VPS\n    );\n\n    const uniquePositions = vpsPositions\n      .filter((position) => position.is_unique)\n      .map((position) => position.name);\n\n    const nonUniquePositions = vpsPositions\n      .filter((position) => !position.is_unique)\n      .map((position) => position.name);\n    if (isEmpty(uniquePositions))\n      return {\n        available: nonUniquePositions,\n        disable: [],\n        is_initial_with_position: isInitialWithPosition\n      };\n    const existsPositions = component.vps\n      ?.filter((vps) => vps.id !== excludeVpsId)\n      ?.filter((vps) => vps.current_status === VpsStatus.IN_USE)\n      .map((vps) => vps.position)\n      .filter(Boolean);\n    const availablePositions = uniquePositions.filter(\n      (position) => !existsPositions?.includes(position as unknown as any)\n    );\n    const disablePositions = uniquePositions.filter((position) =>\n      existsPositions?.includes(position as unknown as any)\n    );\n    return {\n      available: [...availablePositions, ...nonUniquePositions],\n      disable: disablePositions,\n      is_initial_with_position: isInitialWithPosition\n    };\n  }\n\n  async checkIsIpExists(ip: string, id?: number): Promise<boolean> {\n    const query = this.vpsRepository.createQueryBuilder('vps').where('vps.ip = :ip', { ip });\n\n    if (id) query.andWhere('vps.id != :id', { id });\n\n    return query.getExists();\n  }\n\n  async uploadOldVpsByBulk(vpss: any[]) {\n    const vpssToInsert = await Promise.all(\n      vpss.map(async (vps) => {\n        const { vendor_id, component_id, expiry_date, ...rest } = vps;\n        const vendor = await this.vendorService.findOneById(vendor_id);\n        const component = await this.componentService.findById