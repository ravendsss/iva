opup\/types';\nimport { FullColumnFormInput, StyledForm } from '..\/..\/VpsPopup\/styles';\nimport { Typography } from '..\/..\/..\/..\/..\/..\/..\/..\/..\/components\/Typography\/Typography';\nimport { capitalizeFirstLetter } from '..\/..\/..\/..\/..\/..\/..\/..\/..\/components\/utils';\nimport { StyledInfoContainer } from '.\/styles';\nimport FormInput from '..\/..\/..\/..\/..\/..\/..\/..\/..\/components\/FormInput\/FormInput';\nimport DatePicker from '..\/..\/..\/..\/..\/..\/..\/..\/..\/components\/DatePicker\/DatePicker';\nimport dayjs, { Dayjs } from 'dayjs';\nimport { IRenewServerForm } from '..\/EditVpsForm\/types';\nimport { getInitialRenewServerValues } from '..\/..\/..\/utils';\n\nexport interface RenewServerPopup {\n  vpsDetails: IRenewVpsDetails;\n  handleClose: () => void;\n  open: boolean;\n}\n\nconst RenewServerPopup: FC<RenewServerPopup> = ({ vpsDetails, handleClose, open }) => {\n  const { mutate: editVps } = usePutData(\n    ['vps'],\n    `${config.baseUrl}\/${BasePath.vps}\/renew_expiry_date`\n  );\n  const { openSnackbar } = useSnackBarContext();\n\n  const handleEdit = (values: IRenewServerForm) => {\n    const { expiry_date } = values;\n    editVps(\n      { id: values.id, payload: { expiry_date } },\n      {\n        onSuccess: () => {\n          openSnackbar(\n            { message: 'Successfully renew server', type: 'success' },\n            { manualCloseable: true }\n          );\n        },\n        onError: (err) => {\n          openSnackbar(\n            { message: 'Failed to  renew server', type: 'error' },\n            { manualCloseable: true }\n          );\n        },\n        onSettled: () => {\n          handleClose();\n        }\n      }\n    );\n  };\n\n  return (\n    <>\n      {vpsDetails && (\n        <Formik\n          enableReinitialize\n          initialValues={getInitialRenewServerValues(vpsDetails)}\n          validationSchema={renewServerSchema}\n          onSubmit={(values, { resetForm }) => {\n            handleEdit(va