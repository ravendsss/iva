) {\n        acc[key] = {\n          environment_id: item.environment_id,\n          environment_name: item.environment_name ?? 'Unassigned',\n          items: []\n        };\n      }\n\n      acc[key].items.push(item);\n      return acc;\n    },\n    {}\n  );\n\n  return Object.values(grouped);\n}\n\n\n\n\nasync syncRenewServerTasks(): Promise<void> {\n  const vpsRepository = this.dataSource.getRepository(Vps);\n\n  const renewVpsList = await vpsRepository\n    .createQueryBuilder('vps')\n    .leftJoinAndSelect('vps.profile', 'profile')\n    .leftJoinAndSelect('profile.component', 'sourceComponent')\n    .leftJoinAndSelect('sourceComponent.environment', 'sourceEnvironment')\n    .leftJoinAndSelect('vps.vendor', 'vendor')\n    .leftJoinAndSelect('vps.component', 'currentComponent')\n    .leftJoinAndSelect('currentComponent.environment', 'currentEnvironment')\n    .where('vps.expiry_date IS NOT NULL')\n    .andWhere('vps.current_status != :notInUseStatus', { notInUseStatus: VpsStatus.NOT_IN_USE })\n    .andWhere(`DATE_PART('day', vps.expiry_date - CURRENT_DATE) <= 5`)\n    .getMany();\n\n  const actionableVps = renewVpsList.filter(\n    (vps) =>\n      vps.profile?.id &&\n      vps.vendor?.id &&\n      vps.profile.component?.id &&\n      vps.profile.component.environment?.id &&\n      vps.expiry_date\n  );\n\n  const groups = new Map<\n    string,\n    {\n      profile: Profile;\n      vendor: VpsVendor;\n      dueDate: Date;\n      sourceComponent: Component;\n      sourceEnvironment: Environment;\n      vpsList: Vps[];\n    }\n  >();\n\n  actionableVps.forEach((vps) => {\n    const profile = vps.profile!;\n    const vendor = vps.vendor!;\n    const sourceComponent = profile.component!;\n    const sourceEnvironment = sourceComponent.environment!;\n    const dueDate = dayjs(vps.expiry_date).startOf('day').toDate();\n    const key = this.getRenewServerGroupKey(profile.id, vendor.id, dueDate);\n\n    const existingGroup = groups.get(key);\n\n    if (existingGroup) {\n      existingGroup.vpsList.push(vps);\n      return;\n    }\n\n    groups.set(key, {\n      profile,\n      vendor,\n      dueDate,\n      sourceComponent,\n      sourceEnvironment,\n      vpsList: [vps]\n    });\n  });\n\n  const groupValues = Array.from(groups.values());\n\n  \/\/ Close old single-VPS renew tasks so the table does not show duplicates.\n  await this.taskRepository\n    .createQueryBuilder()\n    .update(Task)\n    .set({ status: TaskProgressStatus.DONE })\n    .where('type = :type', { type: TaskTypes.RENEW_SERVER })\n    .andWhere('status != :doneStatus', { doneStatus: TaskProgressStatus.DONE })\n    .andWhere('\"profileId\" IS NULL')\n    .andWhere('\"vpsId\" IS NOT NULL')\n    .execute();\n\n  if (!groupValues.length) return;\n\n  const profileIds = [...new Set(groupValues.map((group) => group.profile.id))];\n\n  const existingTasks = await this.taskRepository.find({\n    where: {\n      type: TaskTypes.RENEW_SERVER,\n      status: Not(TaskProgressStatus.DONE),\n      profile: { id: In(profileIds) }\n    },\n    relations: ['profile', 'vpsVendor', 'environment', 'component']\n  });\n\n  const existingTasksByGroupKey = new Map(\n    existingTasks\n      .filter((task) => task.profile?.id && task.vpsVendor?.id && task.due_date)\n      .map((task) => [\n        this.getRenewServerGroupKey(task.profile!.id, task.vpsVendor!.id, task.due_date!),\n        task\n      ])\n  );\n\n  const activeGroupKeys = new Set(groups.keys());\n  const tasksToSave: Task[] = [];\n\n  existingTasks.forEach((task) => {\n    if (!task.profile?.id || !task.vpsVendor?.id || !task.due_date) return;\n\n    const key = this.getRenewServerGroupKey(task.profile.id, task.vpsVendor.id, task.due_date);\n\n    if (!activeGroupKeys.has(key)) {\n      task.status = TaskProgressStatus.DONE;\n      tasksToSave.push(task);\n    }\n  });\n\n  groupValues.forEach((group) => {\n    const key = this.getRenewServerGroupKey(group.profile.id, group.vendor.id, group.dueDate);\n    const existingTask = existingTasksByGroupKey.get(key);\n\n    if (existingTask) {\n      let shouldSave = false;\n\n      if (existingTask.environment?.id !== group.sourceEnvironment.id) {\n        existingTask.environment = group.sourceEnvironment;\n        shouldSave = true;\n      }\n\n      if (existingTask.component?.id !== group.sourceComponent.id) {\n        existingTask.component = group.sourceComponent;\n        shouldSave = true;\n      }\n\n      if (existingTask.vpsVendor?.id !== group.vendor.id) {\n        existingTask.vpsVendor = group.vendor;\n        shouldSave = true;\n      }\n\n      if (dayjs(existingTask.due_date).format('YYYY-MM-DD') !== dayjs(group.dueDate).format('YYYY-MM-DD')) {\n        existingTask.due_date = group.dueDate;\n        shouldSave = true;\n      }\n\n      if (shouldSave) {\n        tasksToSave.push(existingTask);\n      }\n\n      return;\n    }\n\n    tasksToSave.push(\n      this.taskRepository.create({\n        type: TaskTypes.RENEW_SERVER,\n        due_date: group.dueDate,\n        checklist: checklistByTaskType[TaskTypes.RENEW_SERVER],\n        profile: group.profile,\n        vpsVendor: group.vendor,\n        environment: group.sourceEnvironment,\n        component: group.sourceComponent\n      })\n    );\n  });\n\n  if (tasksToSave.length) {\n    await this.taskRepository.save(tasksToSave);\n  }\n}\n\n\n\n\n\nawait this.syncRenewServerTasks();\nawait this.syncExpiredVpnTasks();\n\n\n\n\n.leftJoinAndSelect('task.profile', 'task_profile')\n.leftJoinAndSelect('task.vpsVendor', 'task_vps_vendor')\n\n\n\n\n.addSelect(\n  `\n  CASE\n    WHEN task.type = '${TaskTypes.RENEW_SERVER}' AND task_profile.id IS NOT NULL THEN (\n      SELECT COUNT(DISTINCT current_environment.id)\n      FROM vps renew_vps\n      JOIN component current_component ON current_component.id = renew_vps.\"componentId\"\n      JOIN environment current_environment ON current_environment.id = current_component.\"environmentId\"\n      WHERE renew_vps.\"profileId\" = task_profile.id\n        AND renew_vps.\"vendorId\" = task_vps_vendor.id\n        AND renew_vps.expiry_date::date = task.due_date::date\n        AND current_environment.id != env.id\n    )\n    ELSE 0\n  END\n  `,\n  'renew_other_clusters_count'\n)\n\n\n\n\n\nrelations: [\n  'environment',\n  'environment.owner',\n  'component',\n  'component.vps',\n  'wallet',\n  'vps',\n  'vps.vendor',\n  'vps.component',\n  'vps.component.environment',\n  'vps.moved_by',\n  'profile',\n  'profile.component',\n  'profile.component.environment',\n  'vpsVendor',\n  'vpn',\n  'vpn.profile',\n  'vpn.profile.emails',\n  'vpn.attached_by',\n  'vpn.vpnComponents',\n  'vpn.vpnComponents.component',\n  'vpn.vpnComponents.component.environment'\n]\n\n\n\n\n\nreturn await this.parseTaskDetails(task);\n\n\n\nprivate async parseTaskDetails(task: Task | null) {\n  \n  \n  \n  private async getRenewServerGroup(task: Task): Promise<IRenewServerGroup | undefined> {\n  if (!task.profile?.id || !task.vpsVendor?.id || !task.due_date) return undefined;\n\n  const vpsRepository = this.dataSource.getRepository(Vps);\n  const expiryDay = dayjs(task.due_date).format('YYYY-MM-DD');\n\n  const vpsList = await vpsRepository\n    .createQueryBuilder('vps')\n    .leftJoinAndSelect('vps.profile', 'profile')\n    .leftJoinAndSelect('vps.vendor', 'vendor')\n    .leftJoinAndSelect('vps.component', 'component')\n    .leftJoinAndSelect('component.environment', 'environment')\n    .where('profile.id = :profileId', { profileId: task.profile.id })\n    .andWhere('vendor.id = :vendorId', { vendorId: task.vpsVendor.id })\n    .andWhere('vps.expiry_date::date = :expiryDay', { expiryDay })\n    .andWhere('vps.current_status != :notInUseStatus', { notInUseStatus: VpsStatus.NOT_IN_USE })\n    .getMany();\n\n  const items: IRenewServerGroupItem[] = vpsList.map((vps) => ({\n    id: `${vps.id}`,\n    vps_id: vps.id,\n    ip: vps.ip,\n    position: vps.position,\n    current_status: vps.current_status,\n    component_id: vps.component?.id,\n    component_name: vps.component?.name,\n    environment_id: vps.component?.environment?.id,\n    environment_name: vps.component?.environment?.name\n  }));\n\n  return {\n    profile_id: task.profile.id,\n    vps_vendor_id: task.vpsVendor.id,\n    vps_site: task.vpsVendor.name,\n    expiry_date: task.due_date,\n    source_environment: task.environment,\n    source_component: task.component,\n    clusters: this.groupRenewServerItemsByCluster(items)\n  };\n}\n\n\n\n\nif (task?.type === TaskTypes.RENEW_SERVER && task.due_date) {\n  const days_left = calculateDaysTimeDiff(task.due_date);\n  const due_date = dayjs(task.due_date).subtract(5, 'day').toDate();\n  const renew_server_group = await this.getRenewServerGroup(task);\n\n  const groupItems =\n    renew_server_group?.clusters.flatMap((cluster) => cluster.items) ?? [];\n\n  const checklist = renew_server_group\n    ? this.getRenewServerChecklistWithChildren(task, groupItems)\n    : task.checklist;\n\n  return {\n    ...parsedTask,\n    checklist,\n    days_left,\n    due_date,\n    renew_server_group\n  } as unknown as ITaskDetailsResponse;\n}\n\n\n\n\n\n\nprivate async getComponentWithProfile(componentId: number): Promise<Component> {\n  const component = await this.dataSource.getRepository(Component).findOne({\n    where: { id: componentId },\n    relations: ['profile', 'environment']\n  });\n\n  if (!component) {\n    Logger.error(`VpsService: getComponentWithProfile - component not found`);\n    throw new BadRequestException('Component not found');\n  }\n\n  return component;\n}\n\n\n\n\nconst [component, vendor, user] = await Promise.all([\n  this.getComponentWithProfile(componentId),\n  this.vendorService.findOneById(vendorId),\n  this.userService.findById(userId)\n]);\n\n\n\n\nconst vpsData = vpss.map((vps) => {\n  return {\n    ...vps,\n    current_status: VpsStatus.BACKUP,\n    component,\n    profile: component.profile,\n    vendor,\n    moved_by: user\n  };\n});\n\n\n\n\nawait this.taskService.syncRenewServerTasks();\n\n\n\n\nconst updatedVps = await this.vpsRepository.save(vps);\n\nif (dto.expiry_date || dto.site_id) {\n  await this.taskService.syncRenewServerTasks();\n}\n\nreturn updatedVps;\n\n\n\n\n\n\nasync renewVpsExpiryDate(vpsId: number, dto: RenewVpsExpiryDateDto) {\n  const vps = await this.findOneById(vpsId);\n  vps.expiry_date = dto.expiry_date;\n\n  const updatedVps = await this.vpsRepository.save(vps);\n\n  await this.taskService.syncRenewServerTasks();\n\n  return updatedVps;\n}\n\n\n\n\nawait this.taskService.syncRenewServerTasks();\n\n\n\n\n\nimport { Box } from '@mui\/material';\nimport { TaskTypes } from '@rubi\/types';\nimport Button from '..\/..\/..\/..\/..\/..\/components\/Button\/Button';\nimport { Typography } from '..\/..\/..\/..\/..\/..\/components\/Typography\/Typography';\nimport Label from '..\/..\/..\/..\/..\/..\/components\/Label\/Label';\nimport { LabelTypes } from '..\/..\/..\/..\/..\/..\/components\/Label\/types';\nimport { theme } from '..\/..\/..\/..\/..\/..\/theme\/styles';\nimport { InfoRowTaskData } from '..\/styles';\nimport { format } from 'date-fns';\nimport { DateFormats } from '@rubi\/types';\n\nconst getGroupedRenewServerInfo = (taskData: ITaskDetailsResponse) => {\n  const group = taskData.renew_server_group;\n\n  if (!group) {\n    return null;\n  }\n\n  return (\n    <>\n      <InfoRowTaskData\n        label=\"Server Details\"\n        children={\n          <Box sx={{ display: 'flex', flexDirection: 'column', gap: '12px', width: '100%' }}>\n            {group.clusters.map((cluster) => (\n              <Box\n                key={cluster.environment_id ?? cluster.environment_name}\n                sx={{ display: 'flex', flexDirection: 'column', gap: '6px', width: '100%' }}\n              >\n                <Typography type=\"subheadingSemi\" color={theme.colors.neutrals[900]}>\n                  {cluster.environment_name}\n                <\/Typography>\n\n                {cluster.items.map((item) => (\n                  <Box\n                    key={item.vps_id}\n                    sx={{\n                      display: 'grid',\n                      gridTemplateColumns: 'minmax(0, 1fr) 120px',\n                      gap: '8px',\n                      alignItems: 'center',\n                      width: '100%'\n                    }}\n                  >\n                    <Box sx={{ display: 'flex', gap: '6px', alignItems: 'center', minWidth: 0 }}>\n                      <Typography type=\"bodyRegular\">\n                        {item.component_name ?? '-'}\n                      <\/Typography>\n\n                      {item.position && (\n                        <Label label={item.position} type={LabelTypes.COMPONENT_NAME} \/>\n                      )}\n                    <\/Box>\n\n                    <Typography type=\"bodyRegular\">{item.ip ?? '-'}<\/Typography>\n                  <\/Box>\n                ))}\n              <\/Box>\n            ))}\n          <\/Box>\n        }\n      \/>\n\n      <InfoRowTaskData label=\"VPS Site\" value={group.vps_site ?? '-'} \/>\n\n      <InfoRowTaskData\n        label=\"Expiry Date\"\n        value={\n          group.expiry_date\n            ? format(new Date(group.expiry_date), DateFormats.DAY_FIRST)\n            : '-'\n        }\n      \/>\n    <\/>\n  );\n};\n\n\n\n\n\n\n\nif (taskData.type === TaskTypes.RENEW_SERVER && taskData.renew_server_group) {\n  return getGroupedRenewServerInfo(taskData);\n}\n\n\n\n\nexport interface ITaskCheckList {\n  checklist: CheckList;\n  updateCheckList: (checklist?: CheckList) => void;\n  handleRedirect: (type: CheckListItemType, renewItem?: IRenewServerGroupItem) => void;\n  renewServerGroup?: IRenewServerGroup;\n}\n  \n  \n  \n  \n  const TaskCheckList = ({\n  checklist,\n  updateCheckList,\n  handleRedirect,\n  renewServerGroup\n}: ITaskCheckList) => {\n    \n    \n    \n    const [isRenewOpen, setIsRenewOpen] = useState(false);\n    \n    \n    \n    \n    const getRenewItemByChild = (child: CheckListChildItem) => {\n  return renewServerGroup?.clusters\n    .flatMap((cluster) => cluster.items)\n    .find((item) => item.vps_id === child.vps_id);\n};\n\nconst onClickChildCheckListItem = (parentItem: CheckListItem, child: CheckListChildItem) => {\n  const updatedChildren =\n    parentItem.children?.map((currentChild) =>\n      currentChild.vps_id === child.vps_id\n        ? { ...currentChild, completed: !currentChild.completed }\n        : currentChild\n    ) ?? [];\n\n  const isParentCompleted =\n    updatedChildren.length > 0 && updatedChildren.every((currentChild) => currentChild.completed);\n\n  updateCheckList(\n    checklist.map((item) =>\n      item.type === parentItem.type\n        ? {\n            ...item,\n            completed: isParentCompleted,\n            children: updatedChildren\n          }\n        : item\n    )\n  );\n};\n    \n    \n    \n    \n    \n    \n    const handleMarkComplete = () => {\n  updateCheckList(\n    checklist?.map((item) => {\n      const completed = !isAllCompleted;\n\n      return {\n        ...item,\n        completed,\n        children: item.children?.map((child) => ({ ...child, completed }))\n      };\n    })\n  );\n};\n    \n    \n    \n    \n    \n    {checklist.map((item) => {\n  const isRenewItem = item.type === CheckListItemType.RENEW && renewServerGroup;\n\n  return (\n    <Box key={item.title} sx={{ width: '100%' }}>\n      <CheckListItemWrapper>\n        <Checkbox\n          checked={item.completed}\n          displayLabel={item.title}\n          onClick={() => {\n            onClickCheckListItem({ ...item, completed: !item.completed });\n          }}\n          key={item.title}\n          lineThrough\n        \/>\n\n        {isRenewItem ? (\n          <Button\n            buttonType=\"tertiaryGrey\"\n            size=\"small\"\n            sourceIcon\n            iconPosition=\"center\"\n            iconName={isRenewOpen ? 'ArrowUpIcon' : 'ArrowDownIcon'}\n            onClick={() => setIsRenewOpen((prev) => !prev)}\n          \/>\n        ) : (\n          item.type !== CheckListItemType.VM && (\n            <Button\n              buttonType=\"tertiaryGrey\"\n              size=\"small\"\n              sourceIcon\n              iconPosition=\"center\"\n              iconName=\"redirect\"\n              onClick={() => handleRedirect(item.type)}\n            \/>\n          )\n        )}\n      <\/CheckListItemWrapper>\n\n      {isRenewItem && (\n        <Collapse in={isRenewOpen}>\n          <Box sx={{ display: 'flex', flexDirection: 'column', gap: '8px', pl: '28px', pt: '8px' }}>\n            {renewServerGroup.clusters.map((cluster) => (\n              <Box\n                key={cluster.environment_id ?? cluster.environment_name}\n                sx={{ display: 'flex', flexDirection: 'column', gap: '6px' }}\n              >\n                <Typography type=\"captionSemi\">{cluster.environment_name}<\/Typography>\n\n                {cluster.items.map((renewItem) => {\n                  const child = item.children?.find((childItem) => childItem.vps_id === renewItem.vps_id);\n\n                  if (!child) return null;\n\n                  return (\n                    <Box\n                      key={renewItem.vps_id}\n                      sx={{\n                        display: 'grid',\n                        gridTemplateColumns: 'minmax(0, 1fr) 120px 24px',\n                        gap: '8px',\n                        alignItems: 'center'\n                      }}\n                    >\n                      <Checkbox\n                        checked={child.completed}\n                        displayLabel={`${renewItem.component_name ?? '-'} ${renewItem.position ?? ''}`}\n                        onClick={() => onClickChildCheckListItem(item, child)}\n                        lineThrough\n                      \/>\n\n                      <Typography type=\"captionRegular\">{renewItem.ip ?? '-'}<\/Typography>\n\n                      <Button\n                        buttonType=\"tertiaryGrey\"\n                        size=\"small\"\n                        sourceIcon\n                        iconPosition=\"center\"\n                        iconName=\"redirect\"\n                        onClick={() => handleRedirect(CheckListItemType.RENEW, renewItem)}\n                      \/>\n                    <\/Box>\n                  );\n                })}\n              <\/Box>\n            ))}\n          <\/Box>\n        <\/Collapse>\n      )}\n    <\/Box>\n  );\n})}\n\n\n\n\n\n\nconst handleRedirect = (type: CheckListItemType, renewItem?: IRenewServerGroupItem) => {\n\n\n\n\ncase CheckListItemType.RENEW: {\n  const environmentId = renewItem?.environment_id ?? taskData.environment?.id;\n  const componentId = renewItem?.component_id ?? taskData.component?.id;\n  const componentName = renewItem?.component_name ?? taskData.component?.name;\n\n  if (!environmentId) break;\n\n  navigate(`clusters\/${environmentId}?tab=servers`, {\n    state: {\n      redirectDetails: {\n        id: componentId,\n        name: componentName,\n        vps: renewItem\n          ? {\n              id: renewItem.vps_id,\n              ip: renewItem.ip,\n              component_name: renewItem.component_name,\n              position: renewItem.position,\n              current_status: renewItem.current_status,\n              site: taskData.renew_server_group?.vps_site,\n              expiry_date: taskData.renew_server_group?.expiry_date\n            }\n          : taskData.vps,\n        type: ActionType.RENEW_SERVER\n      }\n    }\n  });\n\n  break;\n}\n\n\n\n\n\n<TaskInfo\n  taskData={taskData}\n  title={getTaskInfoTitle()}\n\/>\n\n\n\n<TaskCheckList\n  checklist={taskData.checklist}\n  updateCheckList={onCheckListChange}\n  handleRedirect={handleRedirect}\n  renewServerGroup={taskData.renew_server_group}\n\/>\n\n\n\n\n\nrow.renew_other_clusters_count\n\n<FlexRow sx={{ gap: '6px', alignItems: 'center' }}>\n  <Typography type=\"tableText\">{row.environ