per,\n  AttachedRedirectButtonWrapper,\n  AttachedRow,\n  AttachedRowsContainer,\n  FlexAlignedBaseLine,\n  InfoRowTaskData\n} from '..\/styles';\nimport { format } from 'date-fns';\nimport { capitalizeFirstLetter } from '..\/..\/..\/..\/..\/..\/..\/src\/components\/utils';\nimport Label from '..\/..\/..\/..\/..\/..\/..\/src\/components\/Label\/Label';\nimport { LabelTypes } from '..\/..\/..\/..\/..\/..\/..\/src\/components\/Label\/types';\nimport Button from '..\/..\/..\/..\/..\/..\/..\/src\/components\/Button\/Button';\nimport dayjs from 'dayjs';\nimport {\n  ATTACHED_CLUSTER_MAX_WIDTH,\n  ATTACHED_LABEL_MAX_WIDTH,\n  VPN_DETAIL_VALUE_MAX_WIDTH\n} from '..\/consts';\nimport LongTextWrapper from '..\/..\/..\/..\/..\/..\/..\/src\/components\/LongTextWrapper\/LongTextWrapper';\nimport Tooltip from '..\/..\/..\/..\/..\/..\/..\/src\/components\/Tooltip\/Tooltip';\n\nexport enum TaskInfoFields {\n  COMPONENT = 'Component',\n  IP = 'IP',\n  VPS_SITE = 'VPS Site',\n  VPS_POSITION = 'Position',\n  MOVE_REASON = 'Move Reason',\n  EXPIRY_DATE = 'Expiry Date',\n  MOVED_BY = 'Moved By',\n  ON_DATE = 'On Date',\n  TYPE = 'Type',\n  NAME = 'Name',\n  BALANCE = 'Balance',\n  THRESHOLD = 'Threshold',\n  MINIMUM_BACKUPS = 'Minimum Backups',\n  SHORTAGE = 'Shortage',\n  ROLE_NAME = 'Role name',\n  VENDOR = 'Vendor',\n  ACCOUNT_EMAIL = 'Account Email',\n  ACCOUNT_PASSWORD = 'Account Password',\n  VPN_USERNAME = 'VPN Username',\n  VPN_PASSWORD = 'VPN Password',\n  ACTIVATION_CODE = 'Activation Code',\n  ATTACHED = 'Attached'\n}\n\nconst getVpnAccountEmail = (taskData: ITaskDetailsResponse) => {\n  const emails = taskData.vpn?.profile?.emails;\n\n  return Array.isArray(emails) ? emails[0]?.mail : undefined;\n};\n\nconst getVpnUsernameLabel = (vendor?: VpnVendor) => {\n  switch (vendor) {\n    case VpnVendor.PROTON:\n      return 'Proton Username';\n    case VpnVendor.SURFSHARK:\n      return 'Surfshark Username';\n    case VpnVendor.NORD:\n      return 'Nord Username';\n    case VpnVendor.EXPRESS:\n      return 'VPN Username';\n    case VpnVendor.MULLVAD:\n    default:\n      return 'VPN Username';\n  }\n};\n\nconst getVpnPasswordLabel = (vendor?: VpnVendor) => {\n  switch (vendor) {\n    case VpnVendor.PROTON:\n      return 'Proton Password';\n    case VpnVendor.SURFSHARK:\n      return 'Surfshark Password';\n    case VpnVendor.NORD:\n      return 'Nord Password';\n    case VpnVendor.EXPRESS:\n      return 'VPN Password';\n    case VpnVendor.MULLVAD:\n    default:\n      return 'VPN Password';\n  }\n};\n\nconst getVpnAttachedRows = (taskData: ITaskDetailsResponse) => {\n  const attachedComponents = taskData.vpn?.attached_components ?? [];\n  const originalEnvironmentId = taskData.environment?.id;\n\n  if (!attachedComponents.length && taskData.environment) {\n    return [\n      {\n        environment_id: taskData.environment.id,\n        environment_name: taskData.environment.name,\n        components: taskData.component\n          ? [\n              {\n                component_id: taskData.component.id,\n                component_name: taskData.component.name,\n                position: undefined\n              }\n            ]\n          : []\n      }\n    ];\n  }\n\n  const grouped = attachedComponents.reduce<\n    Record<\n      number,\n      {\n        environment_id: number;\n        environment_name: string;\n        components: {\n          component_id?: number;\n          component_name?: string;\n          position?: string;\n        }[];\n      }\n    >\n  >((acc, attached) => {\n    const environmentId = attached.environment_id;\n\n    if (!environmentId) return acc;\n\n    if (!acc[environmentId]) {\n      acc[environmentId] = {\n        environment_id: environmentId,\n        environment_name: attached.environment_name ?? '-',\n        components: []\n      };\n    }\n\n    if (attached.component_name) {\n      acc[environmentId].components.push({\n        component_id: attached.component_id,\n        component_name: attached.component_name,\n        position: attached.position\n      });\n    }\n\n    return acc;\n  }, {});\n\n  if (taskData.environment && originalEnvironmentId && !grouped[originalEnvironmentId]) {\n    grouped[originalEnvironmentId] = {\n      environment_id: originalEnvironmentId,\n      environment_name: taskData.environment.name,\n      components: taskData.component\n        ? [\n            {\n              component_id: taskData.component.id,\n              component_name: taskData.component.name,\n              position: undefined\n            }\n          ]\n        : []\n    };\n  }\n\n  return Object.values(grouped).sort((a, b) => {\n    if (a.environment_id === originalEnvironmentId) return -1;\n    if (b.environment_id === originalEnvironmentId) return 1;\n    return 0;\n  });\n};\n\nconst getAttachedSection = (\n  taskData: ITaskDetailsResponse,\n  handleVpnDrawerRedirect?: (environmentId?: number) => void\n) => {\n  const attachedRows = getVpnAttachedRows(taskData);\n\n  return (\n    <InfoRowTaskData\n      label={TaskInfoFields.ATTACHED}\n      children={\n        <AttachedRowsContainer>\n          {attachedRows.map((row) => (\n            <AttachedRow key={row.environment_id} $clusterWidth={ATTACHED_CLUSTER_MAX_WIDTH}>\n              <AttachedClusterName>\n                <LongTextWrapper\n                  type=\"subheadingRegular\"\n                  color={theme.colors.neutrals[800]}\n                  maxWidth={ATTACHED_CLUSTER_MAX_WIDTH}\n                  lineClamp={1}\n                >\n                  {row.environment_name}\n                <\/LongTextWrapper>\n              <\/AttachedClusterName>\n\n              <AttachedLabelsContainer>\n                {row.components.length > 0 ? (\n                  row.components.map((component) => {\n                    const componentLabel = component.component_name ?? component.position ?? '-';\n\n                    return (\n                      <AttachedLabelWrapper\n                        key={`${row.environment_id}-${\n                          component.component_id ?? component.component_name ?? component.position\n                        }`}\n                        $maxWidth={ATTACHED_LABEL_MAX_WIDTH}\n                      >\n                        <Tooltip title={componentLabel} arrow placement=\"top\">\n                          <div>\n                            <Label\n                              label={componentLabel}\n                              type={LabelTypes.COMPONENT_NAME}\n                              noWrap\n                              maxWidth={ATTACHED_LABEL_MAX_WIDTH}\n                            \/>\n                          <\/div>\n                        <\/Tooltip>\n                      <\/AttachedLabelWrapper>\n                    );\n                  })\n                ) : (\n                  <Typography type=\"subheadingRegular\" color={theme.colors.neutrals[800]}>\n                    -\n                  <\/Typography>\n                )}\n              <\/AttachedLabelsContainer>\n\n              <AttachedRedirectButtonWrapper>\n                <Button\n                  buttonType=\"tertiaryGrey\"\n                  size=\"small\"\n                  sourceIcon\n                  iconPosition=\"center\"\n                  iconName=\"redirect\"\n                  onClick={() => handleVpnDrawerRedirect?.(row.environment_id)}\n                \/>\n              <\/AttachedRedirectButtonWrapper>\n            <\/AttachedRow>\n          ))}\n        <\/AttachedRowsContainer>\n      }\n    \/>\n  );\n};\n\nexport const getTaskInfo = (\n  taskData: ITaskDetailsResponse,\n  handleVpnDrawerRedirect?: (environmentId?: number) => void\n) => {\n  switch (taskData.type) {\n    case TaskTypes.WALLET_THRESHOLD:\n      const dollar = (\n        <Typography type={'captionRegular'} children={'USD'} color={theme.colors.secondary[500]} \/>\n      );\n      return (\n        <>\n          <InfoRowTaskData\n            label={TaskInfoFields.TYPE}\n            value={capitalizeFirstLetter(taskData.wallet?.type ?? '')}\n          \/>\n          <InfoRowTaskData label={TaskInfoFields.NAME} value={taskData.wallet?.name} \/>\n          <InfoRowTaskData\n            label={TaskInfoFields.BALANCE}\n            children={\n              <FlexAlignedBaseLine>\n                <Typography type={'subheadingRegular'} children={taskData.wallet?.dollar_balance} \/>\n                {dollar}\n              <\/FlexAlignedBaseLine>\n            }\n          ><\/InfoRowTaskData>\n          <InfoRowTaskData\n            label={TaskInfoFields.THRESHOLD}\n            children={\n              <FlexAlignedBaseLine>\n                <Typography type={'subheadingRegular'} children={taskData.wallet?.threshold} \/>\n                {dollar}\n              <\/FlexAlignedBaseLine>\n            }\n          ><\/InfoRowTaskData>\n        <\/>\n      );\n    case TaskTypes.MISSING_BACKUP:\n      return (\n        <>\n          <InfoRowTaskData label={TaskInfoFields.COMPONENT} value={taskData.component?.name} \/>\n          <InfoRowTaskData\n            label={TaskInfoFields.MINIMUM_BACKUPS}\n            value={taskData.component?.min_backups.toString()}\n          \/>\n          <InfoRowTaskData\n            label={TaskInfoFields.SHORTAGE}\n            value={taskData.backups_shortage?.toString()}\n          \/>\n        <\/>\n      );\n    case TaskTypes.RENEW_SERVER:\n      return (\n        <>\n          <InfoRowTaskData\n            label={TaskInfoFields.COMPONENT}\n            value={`${taskData.component?.name} - ${taskData.vps?.current_status}`}\n          \/>\n          <InfoRowTaskData label={TaskInfoFields.IP} value={taskData.vps?.ip} \/>\n          <InfoRowTaskData label={TaskInfoFields.VPS_SITE} value={taskData.vps?.vendor.name} \/>\n          <InfoRowTaskData label={TaskInfoFields.VPS_POSITION} value={taskData.vps?.position} \/>\n          <InfoRowTaskData\n            label={TaskInfoFields.EXPIRY_DATE}\n            value={\n              taskData.vps?.expiry_date\n                ? format(taskData.vps.expiry_date, DateFormats.DAY_FIRST)\n                : undefined\n            }\n          \/>\n        <\/>\n      );\n    case TaskTypes.SERVER_NO_LONGER_IN_USE:\n    case TaskTypes.SERVER_UNDER_INSPECTION:\n      \/\/ TODO: Fix Moved By\n      return (\n        <>\n          <InfoRowTaskData label={TaskInfoFields.IP} value={taskData.vps?.ip} \/>\n          <InfoRowTaskData label={TaskInfoFields.VPS_SITE} value={taskData.vps?.vendor.name} \/>\n          <Typography type={'subheadingRegular'} children={'Move Details'} \/>\n          <InfoRowTaskData label={TaskInfoFields.COMPONENT} value={taskData.component?.name} \/>\n          <InfoRowTaskData\n            label={TaskInfoFields.MOVE_REASON}\n            value={taskData.vps?.change_status_reason}\n          \/>\n          <InfoRowTaskData label={TaskInfoFields.MOVED_BY} value={taskData.vps?.moved_by?.name} \/>\n          <InfoRowTaskData\n            label={TaskInfoFields.ON_DATE}\n            value={\n              taskData.vps?.change_status_date\n                ? format(taskData.vps?.change_status_date, DateFormats.DAY_FIRST)\n                : '-'\n            }\n          \/>\n        <\/>\n      );\n    case TaskTypes.EXPIRED_VPN:\n      return (\n        <>\n          <InfoRowTaskData\n            label={TaskInfoFields.ROLE_NAME}\n            children={getLongValue(taskData.vpn?.define_role)}\n          \/>\n          <InfoRowTaskData\n            label={TaskInfoFields.VENDOR}\n            value={capitalizeFirstLetter(taskData.vpn?.vendor ?? '')}\n          \/>\n          <InfoRowTaskData\n            label={TaskInfoFields.ACCOUNT_EMAIL}\n            children={getLongValue(getVpnAccountEmail(taskData))}\n          \/>\n          <InfoRowTaskData\n            label={TaskInfoFields.ACCOUNT_PASSWORD}\n            children={getLongValue(taskData.vpn?.account_password)}\n          \/>\n          <InfoRowTaskData\n            label={getVpnUsernameLabel(taskData.vpn?.vendor)}\n            children={getLongValue(taskData.vpn?.username ?? taskData.vpn?.account_username)}\n          \/>\n          <InfoRowTaskData\n            label={getVpnPasswordLabel(taskData.vpn?.vendor)}\n            children={getLongValue(taskData.vpn?.password)}\n          \/>\n          <InfoRowTaskData\n            label={TaskInfoFields.ACTIVATION_CODE}\n            children={getLongValue(taskData.vpn?.activation_code)}\n          \/>\n          <InfoRowTaskData\n            label={TaskInfoFields.EXPIRY_DATE}\n            value={\n              taskData.vpn?.expiry_date\n                ? format(new Date(taskData.vpn.expiry_date), DateFormats.DAY_FIRST)\n                : '-'\n            }\n          \/>\n          {getAttachedSection(taskData, handleVpnDrawerRedirect)}\n        <\/>\n      );\n  }\n};\n\nexport const getResolvedDaysLeft = (taskData: ITaskDetailsResponse) => {\n  if (typeof taskData.days_left === 'number') {\n    return taskData.days_left;\n  }\n\n  if (!taskData.due_date) {\n    return undefined;\n  }\n\n  return dayjs(taskData.due_date).startOf('day').diff(dayjs().startOf('day'), 'day');\n};\n\nconst getLongValue = (value?: string | null) => {\n  if (!value) return '-';\n\n  return (\n    <LongTextWrapper\n      type=\"bodyRegular\"\n      color={theme.colors.neutrals[800]}\n      maxWidth={VPN_DETAIL_VALUE_MAX_WIDTH}\n      lineClamp={1}\n    >\n      {value}\n    <\/LongTextWrapper>\n  );\n};\n\n\nimport { FlexRowContainer, TaskDataContainer } from '..\/styles';\nimport { ITaskDetailsResponse, TaskPriority, TaskTypes } from '@rubi\/types';\nimport DatePicker from '..\/..\/..\/..\/..\/..\/components\/DatePicker\/DatePicker';\nimport dayjs, { Dayjs } from 'dayjs';\nimport { StyledLabel } from '..\/..\/TaskTable\/styles';\nimport PriorityDropdown from '..\/..\/PriorityDropdown\/PriorityDropdown';\nimport RowTaskData, { RowTaskDataProps } from '.\/RowTaskData';\nimport {\n  TASK_STATUS_TO_LABEL,\n  TASK_STATUS_TO_TITLE\n} from '..\/..\/..\/..\/..\/..\/components\/Label\/types';\nimport { Typography } from '..\/..\/..\/..\/..\/..\/components\/Typography\/Typography';\nimport { theme } from '..\/..\/..\/..\/..\/..\/theme\/styles';\nimport { getDateString } from '..\/..\/..\/utils';\nimport Icon from '..\/..\/..\/..\/..\/..\/components\/Icon\/Icon';\nimport Button from '..\/..\/..\/..\/..\/..\/components\/Button\/Button';\nimport Avatar from '..\/..\/..\/..\/..\/..\/components\/Avatar\/Avatar';\nimport { getInitials } from '..\/..\/..\/..\/..\/..\/components\/Avatar\/utils';\nimport { getResolvedDaysLeft } from '.\/consts';\n\nexport interface ITaskDataSection {\n  taskData: ITaskDetailsResponse;\n  onDateChange: (newValue: Dayjs | null) => void;\n  onPriorityChange: (newSelected: TaskPriority) => void;\n  onClusterRedirect?: () => void;\n}\n\nconst getDueDateSection = (\n  taskData: ITaskDetailsResponse,\n  onDateChange: ITaskDataSection['onDateChange']\n) => {\n  const isReadonlyDueDate =\n    taskData.type === TaskTypes.RENEW_SERVER || taskData.type === TaskTypes.EXPIRED_VPN;\n\n  const resolvedDaysLeft = getResolvedDaysLeft(taskData);\n\n  if (isReadonlyDueDate && taskData.due_date && typeof resolvedDaysLeft === 'number') {\n    return (\n      <FlexRowContainer>\n        <Icon iconName=\"date\" size=\"xl\" \/>\n\n        <Typography\n          type=\"bodyRegular\"\n          color={resolvedDaysLeft < 0 ? theme.colors.error[300] : theme.colors.neutrals[800]}\n        >\n          {getDateString(taskData.due_date, resolvedDaysLeft)}\n        <\/Typography>\n      <\/FlexRowContainer>\n    );\n  }\n\n  return (\n    <DatePicker\n      selectedDate={taskData?.due_date ? dayjs(taskData.due_date) : undefined}\n      onChange={onDateChange}\n      height=\"34px\"\n      isTable\n    \/>\n  );\n};\n\nconst getOwnerSection = (ownerName?: string) => {\n  if (!ownerName) return '-';\n\n  return (\n    <FlexRowContainer>\n      <Avatar color={theme.colors.success[50]}>\n        <Typography type=\"captionSemi\" color={theme.colors.success[250]}>\n          {getInitials(ownerName)}\n        <\/Typography>\n      <\/Avatar>\n\n      <Typography type=\"bodyRegular\" color={theme.colors.neutrals[800]}>\n        {ownerName}\n      <\/Typography>\n    <\/FlexRowContainer>\n  );\n};\n\nconst getClusterSection = (clusterName?: string, onClusterRedirect?: () => void) => {\n  if (!clusterName) return '-';\n\n  return (\n    <FlexRowContainer>\n      <Typography type=\"bodyRegular\" color={theme.colors.neutrals[800]}>\n        {clusterName}\n      <\/Typography>\n\n      <Button\n        buttonType=\"tertiaryGrey\"\n        size=\"small\"\n        sourceIcon\n        iconPosition=\"center\"\n        iconName=\"redirect\"\n        onClick={onClusterRedirect}\n      \/>\n    <\/FlexRowContainer>\n  );\n};\n\nconst TaskDataSection = ({\n  taskData,\n  onDateChange,\n  onPriorityChange,\n  onClusterRedirect\n}: ITaskDataSection) => {\n  const taskDataContent: RowTaskDataProps[] = [\n    {\n      label: 'Owner',\n      children: getOwnerSection(taskData.environment?.owner?.name),\n      labelWidth: '226px'\n    },\n    {\n      label: 'Due Date',\n      children: getDueDateSection(taskData, onDateChange),\n      labelWidth: '226px'\n    },\n    {\n      label: 'Cluster Name',\n      children: getClusterSection(taskData.environment?.name, onClusterRedirect),\n      labelWidth: '226px'\n    },\n    {\n      label: 'Status',\n      children: (\n        <StyledLabel\n          label={TASK_STATUS_TO_TITLE[taskData.status]}\n          type={TASK_STATUS_TO_LABEL[taskData.status]}\n        \/>\n      ),\n      labelWidth: '226px'\n    },\n    {\n      label: 'Priority',\n      children: (\n        <PriorityDropdown onSelect={onPriorityChange} selected={taskData?.priority} height=\"28px\" \/>\n      ),\n      labelWidth: '226px'\n    }\n  ];\n  return (\n    <TaskDataContainer>\n      {taskDataContent.map((rowData) => {\n        return (\n          <RowTaskData\n            key={rowData.label}\n            label={rowData.label}\n            children={rowData.children}\n            value={rowData.value}\n            labelWidth={rowData.labelWidth}\n          \/>\n        );\n      })}\n    <\/TaskDataContainer>\n  );\n};\n\nexport default TaskDataSection;\n\n\n\nimport { CheckList, CheckListItem, CheckListItemType } from '@rubi\/types';\nimport { CheckListContainer, CheckListHeader, CheckListItemWrapper } from '..\/styles';\nimport { Typography } from '..\/..\/..\/..\/..\/..\/components\/Typography\/Typography';\nimport Button from '..\/..\/..\/..\/..\/..\/components\/Button\/Button';\nimport { FlexRow } from '..\/..\/..\/..\/..\/..\/components\/Flex\/Flex';\nimport Checkbox from '..\/..\/..\/..\/..\/..\/components\/Checkbox\/Checkbox';\nimport { useMemo } from 'react';\nimport { theme } from '..\/..\/..\/..\/..\/..\/theme\/styles';\n\nexport interface ITaskCheckList {\n  checklist: CheckList;\n  updateCheckList: (checklist?: CheckList) => void;\n  handleRedirect: (type: CheckListItemType) => void;\n}\n\nconst TaskCheckList = ({ checklist, updateCheckList, handleRedirect }: ITaskCheckList) => {\n  const onClickCheckListItem = (updatedItem: CheckListItem) => {\n    updateCheckList(\n      checklist.map((item) => {\n        return item.type === updatedItem.type ? updatedItem : item;\n      })\n    );\n  };\n\n  const completedCount = useMemo(() => {\n    return checklist?.filter((item) => item.completed)?.length ?? 0;\n  }, [checklist]);\n\n  const isAllCompleted = useMemo(() => {\n    return completedCount === checklist.length;\n  }, [completedCount, checklist]);\n\n  const handleMarkComplete = () => {\n    updateCheckList(\n      checklist?.map((item) => {\n        return { ...item, completed: isAllCompleted ? false : true };\n      })\n    );\n  };\n\n  return (\n    <CheckListContainer>\n      <CheckListHeader>\n        <FlexRow sx={{ gap: theme.spacing[1] }}>\n          <Typography type={'subheadingRegular'} children={'Checklist'} \/>\n          <Typography\n            type=\"captionRegular\"\n            children={`(${completedCount}\/${checklist?.length ?? 0})`}\n          \/>\n        <\/FlexRow>\n        <Button\n          buttonType=\"secondaryGrey\"\n          title={isAllCompleted ? 'Unmark Complete' : 'Mark Complete'}\n          sourceIcon\n          iconName=\"check\"\n          onClick={handleMarkComplete}\n        \/>\n      <\/CheckListHeader>\n      {checklist.map((item) => {\n        return (\n          <CheckListItemWrapper key={item.title}>\n            <Checkbox\n              checked={item.completed}\n              displayLabel={item.title}\n              onClick={() => {\n                onClickCheckListItem({ ...item, completed: !item.completed });\n              }}\n              key={item.title}\n              lineThrough\n            \/>\n            {item.type !== CheckListItemType.VM && (\n              <Button\n                buttonType=\"tertiaryGrey\"\n                size=\"small\"\n                sourceIcon\n                iconPosition=\"center\"\n                iconName=\"redirect\"\n                onClick={() => handleRedirect(item.type)}\n              \/>\n            )}\n          <\/CheckListItemWrapper>\n        );\n      })}\n    <\/CheckListContainer>\n  );\n};\n\nexport default TaskCheckList;\n\n\n\nimport { ITaskDetailsResponse, TaskTypes } from '@rubi\/types';\n\nexport interface TaskDetailsResponseByType {\n  [TaskTypes.MISSING_BACKUP]: ITaskDetailsResponse;\n  [TaskTypes.RENEW_SERVER]: ITaskDetailsResponse;\n  [TaskTypes.SERVER_NO_LONGER_IN_USE]: ITaskDetailsResponse;\n  [TaskTypes.SERVER_UNDER_INSPECTION]: ITaskDetailsResponse;\n  [TaskTypes.WALLET_THRESHOLD]: ITaskDetailsResponse;\n}\n\nexport const ATTACHED_CLUSTER_MAX_WIDTH = '220px';\nexport const ATTACHED_LABEL_MAX_WIDTH = '120px';\nexport const VPN_DETAIL_VALUE_MAX_WIDTH = '280px';\n\n\n\nimport { ReactNode } from 'react';\nimport { RowData } from '..\/styles'