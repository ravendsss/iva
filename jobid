olumn,\n  Entity,\n  JoinColumn,\n  ManyToOne,\n  OneToMany,\n  OneToOne,\n  PrimaryGeneratedColumn\n} from 'typeorm';\nimport { Task } from '..\/..\/task-service\/task\/task.entity';\nimport { MacMini } from '..\/..\/hardware-service\/hardware-items\/mac-mini\/mac-mini.entity';\nimport { RaspberryPI } from '..\/..\/hardware-service\/hardware-items\/raspberry-pi\/raspberry-pi.entity';\nimport { User } from '..\/..\/user-service\/user\/user.entity';\n\n@Entity()\nexport class Vps {\n  @PrimaryGeneratedColumn()\n  @ApiProperty()\n  id!: number;\n\n  @Column({ nullable: true, type: 'varchar' })\n  @ApiProperty()\n  os!: string;\n\n  @ManyToOne(() => Component, (component) => component.vps)\n  component?: Component;\n\n  @ManyToOne(() => Component, { nullable: true })\n  @JoinColumn({ name: 'moved_from_component_id' })\n  moved_from_component?: Component;\n\n  @Column({\n    type: 'timestamp',\n    nullable: true\n  })\n  @ApiProperty()\n  moved_at?: Date;\n\n  @ManyToOne(() => VpsVendor, (vendor) => vendor.vps)\n  vendor?: VpsVendor;\n\n  @Column({ nullable: true, type: 'int' })\n  @ApiProperty()\n  port!: number;\n\n  @Column({ nullable: true, type: 'varchar', default: 'backup' })\n  @ApiProperty()\n  position!: string;\n\n  @Column({ nullable: true, type: 'varchar' })\n  @ApiProperty()\n  user?: string;\n\n  @Column({ nullable: true, type: 'varchar' })\n  @ApiProperty()\n  password!: string;\n\n  @Column({ type: 'varchar', nullable: true })\n  @ApiProperty()\n  file_id?: string;\n\n  @Column({ nullable: true, type: 'varchar' })\n  @ApiProperty()\n  ip!: string;\n\n  @Column({ nullable: true, type: 'varchar' })\n  @ApiProperty()\n  country?: string;\n\n  @Column({\n    type: 'timestamp',\n    nullable: true\n  })\n  @ApiProperty()\n  expiry_date!: Date;\n\n  @CreateDateColumn({ type: 'timestamp' })\n  @ApiProperty()\n  change_status_date!: Date;\n\n  @ManyToOne(() => User, (user) => user.vps)\n  @ApiProperty({ type: () => User })\n  moved_by!: User;\n\n  @ManyToOne(() => User, { nullable: true })\n  @JoinColumn({ name: 'note_updated_by_id' })\n  @ApiProperty({ type: () => User })\n  note_updated_by?: User;\n\n  @Column({\n    type: 'timestamp',\n    nullable: true\n  })\n  @ApiProperty()\n  note_updated_at?: Date;\n\n  @Column({ nullable: true, type: 'enum', enum: VpsStatus, default: VpsStatus.BACKUP })\n  @ApiProperty()\n  current_status!: VpsStatus;\n\n  @Column({ nullable: true, type: 'enum', enum: VpsStatus })\n  @ApiProperty()\n  last_status?: VpsStatus;\n\n  @Column({ nullable: true, type: 'varchar' })\n  @ApiProperty()\n  change_status_reason?: string;\n\n  @Column({ nullable: true, type: 'varchar' })\n  @ApiProperty()\n  note?: string;\n\n  @OneToOne(() => TaylorAttacker, (taylorAttacker) => taylorAttacker.vps)\n  attacker?: TaylorAttacker[];\n\n  @OneToMany(() => Task, (task) => task.vps)\n  tasks?: Task[];\n\n  @OneToOne(() => MacMini, (macMini) => macMini.vps_id)\n  @ApiProperty()\n  mac_mini?: MacMini;\n\n  @OneToOne(() => RaspberryPI, (raspberryPi) => raspberryPi.near_vps_id)\n  @ApiProperty()\n  raspberrypi_near?: RaspberryPI;\n\n  @OneToOne(() => RaspberryPI, (raspberryPi) => raspberryPi.far_attacker_vps_id)\n  @ApiProperty()\n  raspberrypi_far_attacker?: RaspberryPI;\n}\n\n\n\n\n\n\n\n\n\nimport { ApiProperty } from '@nestjs\/swagger';\nimport {\n  ChildEntity,\n  Column,\n  Entity,\n  JoinColumn,\n  ManyToOne,\n  OneToMany,\n  OneToOne,\n  PrimaryGeneratedColumn,\n  TableInheritance\n} from 'typeorm';\nimport { Wallet } from '..\/..\/wallet-service\/wallet\/wallet.entity';\nimport { Component } from '..\/..\/environment-service\/component\/component.entity';\nimport { Environment } from '..\/..\/environment-service\/environment\/environment.entity';\nimport { Email } from '..\/email\/email.entity';\nimport { Bucket } from '..\/..\/bucket-service\/bucket.entity';\nimport { AirAccount } from '..\/air-account\/air-account.entity';\nimport { ProfileTypes } from '@rubi\/types';\nimport { Attacker } from '..\/..\/environment-service\/attacker\/attacker.entity';\nimport { CreditCard } from '..\/..\/inventory-service\/credit-card\/credit-card.entity';\nimport { Vpn } from '..\/..\/inventory-service\/vpn\/vpn.entity';\nimport {\n  AttackerProfileAccount,\n  AttackerProfilePhone,\n  AttackerProfilePayment\n} from '.\/attacker-profile-connections.entity';\nimport { Sim } from '..\/..\/inventory-service\/sim\/sim.entity';\nimport { VpsAccount } from '..\/vps-account\/vps-account.entity';\nimport { ManuallyCreditCard } from '..\/manually-credit-card\/manually-credit-card.entity';\n\n@Entity()\n@TableInheritance({ column: { type: 'enum', enum: ProfileTypes, name: 'type' } })\nexport class Profile {\n  @PrimaryGeneratedColumn()\n  @ApiProperty()\n  id!: number;\n\n  @Column({ type: 'varchar', nullable: true })\n  @ApiProperty()\n  country?: string;\n\n  @Column({ type: 'varchar' })\n  @ApiProperty()\n  name!: string;\n\n  @Column({ type: 'varchar', nullable: true })\n  @ApiProperty()\n  address?: string;\n\n  @Column({ type: 'timestamp', nullable: true })\n  @ApiProperty()\n  date_of_birth?: Date;\n\n  @Column('enum', { enum: ProfileTypes })\n  @ApiProperty()\n  type!: ProfileTypes;\n\n  @Column({ type: 'varchar', nullable: true })\n  @ApiProperty()\n  phone?: string;\n\n  @OneToOne(() => Component, (component) => component.profile, { nullable: true })\n  \/\/ @ApiProperty()\n  component?: Component;\n\n  @ManyToOne(() => Environment, (environment) => environment.profiles, { nullable: true })\n  \/\/ @ApiProperty({type:()=>Environment})\n  environment?: Environment;\n\n  @OneToMany(() => Wallet, (wallet) => wallet.profile, { nullable: true })\n  \/\/ @ApiProperty({ type: () =>Wallet })\n  wallets?: Wallet[];\n\n  @OneToMany(() => CreditCard, (credit) => credit.profile, { nullable: true })\n  \/\/ @ApiProperty({ type: () =>Wallet })\n  credit_cards?: CreditCard[];\n\n  @OneToMany(() => Sim, (sim) => sim.profile, { nullable: true })\n  \/\/ @ApiProperty({ type: () =>Wallet })\n  sims?: Sim[];\n\n  @OneToMany(() => Email, (email) => email.profile, { nullable: true })\n  emails?: Email[];\n\n  @OneToMany(() => ManuallyCreditCard, (manuallyCreditCard) => manuallyCreditCard.profile, {\n    nullable: true\n  })\n  manually_credit_cards?: ManuallyCreditCard[];\n\n  @OneToMany(() => VpsAccount, (vpsAccount) => vpsAccount.profile, { nullable: true })\n  vps_accounts?: VpsAccount[];\n\n  @OneToOne(() => Bucket, (bucket) => bucket.profile, { nullable: true })\n  bucket?: Bucket;\n\n  @OneToOne(() => AirAccount, (air_account) => air_account.profile, { nullable: true })\n  air_account?: AirAccount;\n\n  @OneToOne(() => Vpn, (vpn) => vpn.profile, { nullable: true })\n  vpn?: Vpn;\n}\n\n@ChildEntity(ProfileTypes.ATTACKER)\nexport class AttackerProfile extends Profile {\n  @ManyToOne(() => Attacker, (attacker) => attacker.profiles)\n  attacker!: Attacker;\n\n  @OneToOne(() => AttackerProfilePhone, (attackerPhone) => attackerPhone.profile)\n  @JoinColumn()\n  attackerPhone!: AttackerProfilePhone;\n\n  @OneToOne(() => AttackerProfilePayment, (attackerPayment) => attackerPayment.profile)\n  @JoinColumn()\n  attackerPayment!: AttackerProfilePayment;\n\n  @OneToOne(() => AttackerProfileAccount, (attackerAccount) => attackerAccount.profile)\n  @JoinColumn()\n  attackerAccount!: AttackerProfileAccount;\n}\n\n@ChildEntity(ProfileTypes.MAIN)\nexport class MainProfile extends Profile {}\n\n@ChildEntity(ProfileTypes.BUCKET)\nexport class BucketProfile extends Profile {}\n\n@ChildEntity(ProfileTypes.CLEAN)\nexport class CleanProfile extends Profile {}\n\n@ChildEntity(ProfileTypes.COMPONENT)\nexport class ComponentProfile extends Profile {}\n\n@ChildEntity(ProfileTypes.EXPRESS)\nexport class ExpressProfile extends Profile {}\n\n@ChildEntity(ProfileTypes.VPN)\nexport class VpnProfile extends Profile {}\n\n@ChildEntity(ProfileTypes.CREDIT_CARD)\nexport class CreditCardProfile extends Profile {}\n\n\n\n\n\nimport { ApiProperty } from '@nestjs\/swagger';\nimport {\n  Column,\n  Entity,\n  JoinColumn,\n  ManyToOne,\n  OneToOne,\n  OneToMany,\n  PrimaryGeneratedColumn\n} from 'typeorm';\nimport { Environment } from '..\/..\/environment-service\/environment\/environment.entity';\nimport { Profile } from '..\/..\/profile-service\/profile\/profile.entity';\nimport { Vps } from '..\/..\/inventory-service\/vps\/vps.entity';\nimport { Task } from '..\/..\/task-service\/task\/task.entity';\nimport { VpnComponent } from '..\/..\/inventory-service\/vpn\/vpn-component\/vpn-component.entity';\nimport { PositionDto } from '..\/componentTemplate\/componentTemplate.dto';\n\n@Entity()\nexport class Component {\n  @PrimaryGeneratedColumn()\n  @ApiProperty()\n  id!: number;\n\n  @Column({ type: 'varchar' })\n  @ApiProperty()\n  name!: string;\n\n  @OneToMany(() => Vps, (vps) => vps.component)\n  vps?: Vps[];\n\n  @Column({ type: 'int' })\n  @ApiProperty()\n  min_backups!: number;\n\n  @Column({ type: 'boolean', default: false })\n  @ApiProperty()\n  backup_position!: boolean;\n\n  @Column({ type: 'jsonb', nullable: true })\n  @ApiProperty()\n  positions?: PositionDto[];\n\n  @Column({ type: 'int', default: 30 })\n  @ApiProperty()\n  timer_by_days_number!: number;\n\n  @Column({ type: 'timestamp', nullable: true })\n  last_moved_at?: Date;\n\n  @ManyToOne(() => Environment, (environment) => environment.components)\n  environment!: Environment;\n\n  @OneToMany(() => VpnComponent, (vc) => vc.component)\n  vpnComponents?: VpnComponent[];\n\n  @OneToOne(() => Profile, (profile) => profile.component)\n  @JoinColumn()\n  profile?: Profile;\n\n  @OneToMany(() => Task, (task) => task.component)\n  @JoinColumn()\n  tasks?: Task[];\n}\n\n\n\n\n\nimport { Column, CreateDateColumn, Entity, ManyToOne, PrimaryGeneratedColumn } from 'typeorm';\nimport { Wallet } from '..\/..\/wallet-service\/wallet\/wallet.entity';\nimport { CheckList, TaskPriority, TaskProgressStatus, TaskTypes } from '@rubi\/types';\nimport { Environment } from '..\/..\/environment-service\/environment\/environment.entity';\nimport { Component } from '..\/..\/environment-service\/component\/component.entity';\nimport { Vps } from '..\/..\/inventory-service\/vps\/vps.entity';\nimport { Vpn } from '..\/..\/inventory-service\/vpn\/vpn.entity';\n\n@Entity()\nexport class Task {\n  @PrimaryGeneratedColumn()\n  id!: number;\n\n  @Column({ type: 'enum', enum: TaskTypes })\n  type!: TaskTypes;\n\n  @Column({ type: 'enum', enum: TaskProgressStatus, default: TaskProgressStatus.NEW })\n  status!: TaskProgressStatus;\n\n  @Column({\n    type: 'enum',\n    enum: TaskPriority,\n    enumName: 'priority',\n    default: TaskPriority.NORMAL\n  })\n  priority!: TaskPriority;\n\n  @Column({ type: 'jsonb', nullable: false })\n  checklist!: CheckList;\n\n  @Column({ type: 'timestamp', nullable: true })\n  due_date?: Date;\n\n  @ManyToOne(() => Environment, (environment) => environment.tasks)\n  environment?: Environment;\n\n  @ManyToOne(() => Component, (component) => component.tasks)\n  component?: Component;\n\n  @ManyToOne(() => Wallet, (wallet) => wallet.tasks)\n  wallet?: Wallet;\n\n  @ManyToOne(() => Vps, (vps) => vps.tasks)\n  vps?: Vps;\n\n  @ManyToOne(() => Vpn, (vpn) => vpn.tasks)\n  vpn?: Vpn;\n\n  @CreateDateColumn({ type: 'timestamp' })\n  created_at!: Date;\n}\n\n\n\n\n\nimport { BadRequestException, Injectable, Logger } from '@nestjs\/common';\nimport { InjectRepository } from '@nestjs\/typeorm';\nimport { DataSource, In, Not, QueryRunner, Repository } from 'typeorm';\nimport { Task } from '.\/task.entity';\nimport {\n  calculateDaysLeft,\n  CheckList,\n  checklistByTaskType,\n  dueDateCase,\n  filterableServersTaskFields,\n  filterableWalletsTaskFields,\n  ICalendarTaskResponse,\n  IRawResponseServersTask,\n  IRawResponseWalletsTask,\n  IRawVps,\n  IResponse,\n  ITaskDetailsResponse,\n  LabelsData,\n  selectComponentId,\n  selectComponentName,\n  selectServersTasksQueryFields,\n  selectSubQueryServersTasksQueryFields,\n  selectSubQueryWalletsTasksQueryFields,\n  selectWalletsTasksQueryFields,\n  SortOrderEnum,\n  TaskFilterableFieldsEnum,\n  TaskProgressStatus,\n  TasksLabels,\n  TasksTabsTypes,\n  TaskTypes,\n  VpnStatus,\n  VpnType,\n  VpsStatus\n} from '@rubi\/types';\nimport { UpdateTaskDto } from '.\/task.dto';\nimport { Environment } from '..\/..\/environment-service\/environment\/environment.entity';\nimport { QueryBuilder } from 'apps\/core-service\/src\/query-builder\/query-builder';\nimport { QueryDto } from 'apps\/core-service\/src\/query-builder\/query.dto';\nimport { Vps } from '..\/..\/inventory-service\/vps\/vps.entity';\nimport { getCount } from 'apps\/core-service\/src\/utils\/getCount';\nimport { calculateDaysTimeDiff } from 'apps\/core-service\/src\/utils\/calculateTimeDiff';\nimport { endOfMonth, endOfWeek, startOfMonth, startOfWeek } from 'date-fns';\nimport dayjs from 'dayjs';\nimport { Vpn } from '..\/..\/inventory-service\/vpn\/vpn.entity';\n\n@Injectable()\nexport class TaskService {\n  constructor(\n    @InjectRepository(Task) private taskRepository: Repository<Task>,\n    private readonly dataSource: DataSource\n  ) {}\n\n  async createTask<T>(\n    relation: T,\n    environment: Environment | undefined,\n    taskType: TaskTypes,\n    dueDate?: Date,\n    queryRunner?: QueryRunner\n  ) {\n    const task = this.taskRepository.create({\n      [this.getRelationFieldByTaskType(taskType)]: relation,\n      environment,\n      type: taskType,\n      due_date: dueDate,\n      checklist: checklistByTaskType[taskType]\n    });\n\n    if (queryRunner) return queryRunner.manager.save(Task, task);\n\n    return this.taskRepository.save(task);\n  }\n\n  async updateVpsLastTask(vps: Vps) {\n    if (!vps.tasks) return;\n    const lastTask = vps.tasks[vps.tasks.length - 1];\n    lastTask.due_date = vps.expiry_date;\n    await this.updateTask(lastTask.id, lastTask);\n  }\n\n  async findOneById(id: number): Promise<Task> {\n    const task = await this.taskRepository.findOne({ where: { id } });\n    if (!task) {\n      Logger.error(`taskService: findById - task with id: ${id} not found`);\n      throw new BadRequestException(`task with id: ${id} not found`);\n    }\n    return task;\n  }\n\n  private getRelationFieldByTaskType(taskType: TaskTypes): keyof Task {\n    switch (taskType) {\n      case TaskTypes.MISSING_BACKUP:\n        return 'component';\n\n      case TaskTypes.RENEW_SERVER:\n      case TaskTypes.SERVER_NO_LONGER_IN_USE:\n      case TaskTypes.SERVER_UNDER_INSPECTION:\n        return 'vps';\n\n      case TaskTypes.EXPIRED_VPN:\n        return 'vpn';\n\n      case TaskTypes.WALLET_THRESHOLD:\n        return 'wallet';\n\n      default:\n        throw new Error(`Unknown task type: ${taskType}`);\n    }\n  }\n\n  async updateTask(id: number, body: UpdateTaskDto) {\n    Logger.log(`${TaskService.name} - updateTask with ID ${id} `);\n\n    if (body.checklist) {\n      const status = this.getStatusByChecklist(body.checklist);\n      return this.taskRepository.save({ id, ...body, status });\n    }\n\n    \/\/ Validating that due_date will not be updated if task is of type renew server\n    if (body.due_date) {\n      const task = await this.findOneById(id);\n      if (task.type === TaskTypes.RENEW_SERVER) delete body.due_date;\n    }\n\n    return this.taskRepository.save({ id, ...body });\n  }\n\n  private getStatusByChecklist(checkList: CheckList) {\n    const completedTasks = checkList.filter((task) => task.completed);\n\n    if (!completedTasks.length) return TaskProgressStatus.NEW;\n\n    if (completedTasks.length < checkList.length) return TaskProgressStatus.IN_PROGRESS;\n\n    return TaskProgressStatus.DONE;\n  }\n\n  async queryWalletsTasks(\n    query: QueryDto,\n    isClosed: boolean = false,\n    includeTotal: boolean = true\n  ): Promise<IResponse<IRawResponseWalletsTask>> {\n    const statusOperator = isClosed ? '=' : '!=';\n    const tasksQB = this.taskRepository\n      .createQueryBuilder('task')\n      .leftJoinAndSelect('task.wallet', 'wallet')\n      .leftJoinAndSelect('component', 'component', 'wallet.profileId=component.profileId')\n      .leftJoinAndSelect('task.environment', 'env')\n      .leftJoinAndSelect('env.owner', 'env_owner')\n      .where(`task.status ${statusOperator} :status`, { status: TaskProgressStatus.DONE })\n      .andWhere('task.type = :taskType', { taskType: TaskTypes.WALLET_THRESHOLD })\n      .select(selectWalletsTasksQueryFields)\n      .orderBy('task.due_date', SortOrderEnum.asc, 'NULLS LAST');\n\n    const queryBuilder = new QueryBuilder(tasksQB);\n    const tasksFilteredQuery = queryBuilder.applyQuery(query, filterableWalletsTaskFields);\n    const subQuery = tasksFilteredQuery.getQuery();\n    const baseQuery = this.dataSource\n      .createQueryBuilder()\n      .select(selectSubQueryWalletsTasksQueryFields)\n      .from(`(${subQuery})`, 'subquery')\n      .setParameters(tasksQB.getParameters());\n    const finalQueryBuilder = new QueryBuilder(baseQuery);\n    let total: number = 0;\n\n    if (includeTotal) {\n      total = await getCount(this.dataSource, tasksFilteredQuery);\n    }\n\n    const taskDataQuery = finalQueryBuilder.applyPagination(query);\n\n    const data = await taskDataQuery.getRawMany();\n\n    return { data, total };\n  }\n\n  private getVpnTaskComponent(vpn: Vpn) {\n    return vpn.vpnComponents?.find((vpnComponent) => vpnComponent.component)?.component;\n  }\n\n  private getVpnTaskEnvironment(vpn: Vpn) {\n    return vpn.environment ?? this.getVpnTaskComponent(vpn)?.environment;\n  }\n\n  private getVpnExpiryDate(vpn: Vpn): Date | undefined {\n    const expiryDate = (vpn.details as { expiry_date?: Date | string } | undefined)?.expiry_date;\n    return expiryDate ? new Date(expiryDate) : undefined;\n  }\n\n  private async syncExpiredVpnTasks(): Promise<void> {\n    const vpnRepository = this.dataSource.getRepository(Vpn);\n\n    const expiredVpns = await vpnRepository\n      .createQueryBuilder('vpn')\n      .leftJoinAndSelect('vpn.environment', 'environment')\n      .leftJoinAndSelect('vpn.vpnComponents', 'vpnComponents')\n      .leftJoinAndSelect('vpnComponents.component', 'component')\n      .leftJoinAndSelect('component.environment', 'componentEnvironment')\n      .where('vpn.status != :archivedStatus', { archivedStatus: VpnStatus.ARCHIVE })\n      .andWhere('vpn.type != :purchaserType', { purchaserType: VpnType.PURCHASER })\n      .andWhere(`vpn.details->>'expiry_date' IS NOT NULL`)\n      .andWhere(`vpn.details->>'expiry_date' != ''`)\n      .andWhere(`((vpn.details->>'expiry_date')::date - CURRENT_DATE) <= 5`)\n      .getMany();\n\n    const actionableExpiredVpns = expiredVpns.filter((vpn) => {\n      const environment = this.getVpnTaskEnvironment(vpn);\n\n      return Boolean(environment);\n    });\n\n    const actionableExpiredVpnIds = actionableExpiredVpns.map((vpn) => vpn.id);\n\n    if (!actionableExpiredVpns.length) return;\n\n    const existingTasks = await this.taskRepository.find({\n      where: {\n        type: TaskTypes.EXPIRED_VPN,\n        status: Not(TaskProgressStatus.DONE),\n        vpn: { id: In(actionableExpiredVpnIds) }\n      },\n      relations: ['vpn', 'environment', 'component']\n    });\n\n    const existingTasksByVpnId = new Map(\n      existingTasks.filter((task) => task.vpn?.id).map((task) => [task.vpn!.id, task])\n    );\n\n    const tasksToSave: Task[] = [];\n\n    actionableExpiredVpns.forEach((vpn) => {\n      const environment = this.getVpnTaskEnvironment(vpn);\n      const component = this.getVpnTaskComponent(vpn);\n      const dueDate = this.getVpnExpiryDate(vpn);\n      const existingTask = existingTasksByVpnId.get(vpn.id);\n\n      if (!environment || !dueDate) return;\n\n      if (existingTask) {\n        let shouldSave = false;\n\n        if (existingTask.environment?.id !== environment.id) {\n          existingTask.environment = environment;\n          shouldSave = true;\n        }\n\n        if (component && existingTask.component?.id !== component.id) {\n          existingTask.component = component;\n          shouldSave = true;\n        }\n\n        if (existingTask.due_date?.getTime() !== dueDate.getTime()) {\n          existingTask.due_date = dueDate;\n          shouldSave = true;\n        }\n\n        if (!component && existingTask.component) {\n          existingTask.component = undefined;\n          shouldSave = true;\n        }\n\n        if (shouldSave) {\n          tasksToSave.push(existingTask);\n        }\n\n        return;\n      }\n\n      tasksToSave.push(\n        this.taskRepository.create({\n          vpn,\n          environment,\n          ...(component && { component }),\n          type: TaskTypes.EXPIRED_VPN,\n          due_date: dueDate,\n          checklist: checklistByTaskType[TaskTypes.EXPIRED_VPN]\n        })\n      );\n    });\n\n    if (!tasksToSave.length) return;\n\n    await this.taskRepository.save(tasksToSave);\n  }\n\n  async queryServersTasks(\n    query: QueryDto,\n    isClosed: boolean = false,\n    includeTotal: boolean = true\n  ): Promise<IResponse<IRawResponseServersTask>> {\n    await this.syncExpiredVpnTasks();\n\n    const statusOperator = isClosed ? '=' : '!=';\n    const allTasksCondition = includeTotal ? 'AND' : 'OR';\n\n    const backupsCountSubQuery = this.dataSource\n      .createQueryBuilder()\n      .select('vps.\"componentId\"', 'component_id')\n      .addSelect('COUNT(*)', 'backups_count')\n      .from('vps', 'vps')\n      .where('vps.current_status = :vpsBackup', { vpsBackup: VpsStatus.BACKUP })\n      .groupBy('vps.\"componentId\"');\n\n    const tasksQB = this.taskRepository\n      .createQueryBuilder('task')\n      .leftJoinAndSelect('task.vps', 'task_vps')\n      .leftJoinAndSelect('task.vpn', 'task_vpn')\n      .leftJoinAndSelect('task.environment', 'env')\n      .leftJoinAndSelect('env.owner', 'env_owner')\n      .leftJoinAndSelect('task_vps.component', 'vps_component')\n      .leftJoinAndSelect('task.component', 'task_component')\n      .leftJoin(\n        '(' + backupsCountSubQuery.getQuery() + ')',\n        'backup_stats',\n        'backup_stats.component_id = task_component.id'\n      )\n      .where(`task.status ${statusOperator} :status`, { status: TaskProgressStatus.DONE })\n      .andWhere(\n        `((\"task\".\"type\" = 'renew_server' ${allTasksCondition} DATE_PART('day', \"task\".\"due_date\" - CURRENT_DATE) <= 5) OR (\"task\".\"type\" !=  'renew_server'))`\n      )\n      .andWhere('task.type != :taskType', { taskType: TaskTypes.WALLET_THRESHOLD })\n      .addSelect(selectServersTasksQueryFields)\n      .addSelect(selectComponentName, 'component_name')\n      .addSelect(selectComponentId, 'component_id')\n      .addSelect('COALESCE(backup_stats.backups_count, 0)', 'backups_count')\n      .setParameters(backupsCountSubQuery.getParameters());\n\n    !query.sort_by && tasksQB.orderBy('task.due_date', SortOrderEnum.asc, 'NULLS LAST');\n\n    if (query.sort_by === TaskFilterableFieldsEnum.DUE_DATE)\n      tasksQB.orderBy('task.due_date', SortOrderEnum.desc, 'NULLS LAST');\n\n    const queryBuilder = new QueryBuilder(tasksQB);\n    const tasksFilteredQuery = queryBuilder.applyQuery(query, filterableServersTaskFields);\n    const subQuery = tasksFilteredQuery.getQuery();\n\n    const baseQuery = this.dataSource\n      .createQueryBuilder()\n      .select(selectSubQueryServersTasksQueryFields)\n      .addSelect(calculateDaysLeft, 'days_left')\n      .addSelect(dueDateCase, 'due_date')\n      .from(`(${subQuery})`, 'subquery')\n      .setParameters(tasksQB.getParameters());\n\n    let total: number = 0;\n\n    if (includeTotal) {\n      total = await getCount(this.dataSource, tasksFilteredQuery);\n    }\n\n    const finalQueryBuilder = new QueryBuilder(baseQuery);\n    const taskDataQuery = finalQueryBuilder.applyPagination(query);\n\n    const data = await taskDataQuery.getRawMany();\n\n    return { data, total };\n  }\n\n  private calculateBackupsShortage(task: Task) {\n    const backups = task.component!.vps!.filter((vps) => vps.current_status === VpsStatus.BACKUP);\n    const minBackups = task.component!.min_backups;\n    const current_backups = backups.length;\n    const backups_shortage = minBackups - current_backups;\n    return { current_backups, backups_shortage };\n  }\n\n  async getTaskDetails(id: number) {\n    const task = await this.taskRepository.findOne({\n      where: { id },\n      relations: [\n        'environment',\n        'environment.owner',\n        'component',\n        'component.vps',\n        'wallet',\n        'vps',\n        'vps.vendor',\n        'vps.component',\n        'vps.moved_by',\n        'vpn',\n        'vpn.profile',\n        'vpn.profile.emails',\n        'vpn.attached_by',\n        'vpn.vpnComponents',\n        'vpn.vpnComponents.component',\n        'vpn.vpnComponents.component.environment'\n      ]\n    });\n\n    return this.parseTaskDetails(task);\n  }\n  private checkValidDateQueryCalendar(body: QueryDto): QueryDto {\n    if (!body.filter?.dateFilter || body.filter?.dateFilter.length === 0) {\n      return {\n        ...body,\n        filter: {\n          include: body.filter?.include ?? [],\n          exclude: body.filter?.exclude ?? [],\n          dateFilter: [\n            {\n              field: TaskFilterableFieldsEnum.DUE_DATE,\n              values: [startOfWeek(startOfMonth(new Date())), endOfWeek(endOfMonth(new Date()))]\n            }\n          ]\n        }\n      };\n    } else {\n      return body;\n    }\n  }\n\n  async getCalendarTasks(body: QueryDto, isClosed: boolean): Promise<ICalendarTaskResponse> {\n    let query: QueryDto = this.checkValidDateQueryCalendar(body);\n    const { data: serversTasks } = await this.queryServersTasks(query, isClosed, false);\n    const { data: walletsTasks } = await this.queryWalletsTasks(query, isClosed, false);\n\n    return [...serversTasks, ...walletsTasks];\n  }\n\n  private parseTaskDetails(task: Task | null) {\n    const parsedTask = {\n      ...task,\n      environment: task?.environment,\n      component: task?.component ?? task?.vps?.component,\n      vps: task?.vps ?? task?.component?.vps,\n      vpn: this.parseVpnTaskDetails(task?.vpn),\n      wallet: task?.wallet\n    };\n\n    if (task?.type === TaskTypes.RENEW_SERVER && task.due_date) {\n      const days_left = calculateDaysTimeDiff(task.due_date);\n      const due_date = dayjs(task.due_date).subtract(5, 'day').toDate();\n\n      \/\/ TODO:  check with spec if days can be positive to a limit\n      return { ...parsedTask, days_left, due_date } as unknown as ITaskDetailsResponse;\n    }\n\n    if (task?.type === TaskTypes.MISSING_BACKUP && task.component?.vps) {\n      const { current_backups, backups_shortage } = this.calculateBackupsShortage(task);\n      return {\n        ...parsedTask,\n        backups_shortage,\n        current_backups\n      } as unknown as ITaskDetailsResponse;\n    }\n\n    return parsedTask as unknown as ITaskDetailsResponse;\n  }\n\n  private parseVpnTaskDetails(vpn?: Vpn) {\n    if (!vpn) return undefined;\n\n    return {\n      ...vpn,\n      ...vpn.details,\n      attached_by: vpn.attached_by?.name,\n      attached_components:\n        vpn.vpnComponents?.map((vpnComponent) => ({\n          component_name: vpnComponent.component?.name,\n          component_id: vpnComponent.component?.id,\n          environment_name: vpnComponent.component?.environment?.name,\n          environment_id: vpnComponent.component?.environment?.id,\n          position: vpnComponent.position,\n          status: vpnComponent.status\n        })) ?? []\n    };\n  }\n\n  async getClustersNames(tabType: TasksTabsTypes) {\n    const typeOperator = tabType === TasksTabsTypes.WALLET ? '=' : '!=';\n\n    const tasksQB = this.taskRepository\n      .createQueryBuilder('task')\n      .leftJoinAndSelect('task.environment', 'environment')\n      .andWhere(`task.type ${typeOperator} :taskType`, { taskType: TaskTypes.WALLET_THRESHOLD })\n      .select(['environment.id as id', 'environment.name as name'])\n      .groupBy('environment.id');\n\n    return tasksQB.getRawMany();\n  }\n  async getFilterNames(tabType: TasksTabsTypes) {\n    switch (tabType) {\n      case TasksTabsTypes.SERVER:\n        return this.getComponentNames();\n      case TasksTabsTypes.WALLET:\n        return this.getWalletNames();\n      default:\n        return [];\n    }\n  }\n  async getComponentNames() {\n    const tasksQB = this.taskRepository\n      .createQueryBuilder('task')\n      .leftJoinAndSelect('task.component', 'component')\n      .andWhere(`task.type != :taskType`, { taskType: TaskTypes.WALLET_THRESHOLD })\n      .select(['component.id as id', 'component.name as name'])\n      .groupBy('component.id');\n\n    return tasksQB.getRawMany();\n  }\n  async getWalletNames() {\n    const tasksQB = this.taskRepository\n      .createQueryBuilder('task')\n      .leftJoinAndSelect('task.wallet', 'wallet')\n      .andWhere(`task.type = :taskType`, { taskType: TaskTypes.WALLET_THRESHOLD })\n      .select(['wallet.id as id', 'wallet.name as name'])\n      .groupBy('wallet.id');\n\n    return tasksQB.getRawMany();\n  }\n\n  async removeTasksByVpsId(vpsId: number): Promise<void> {\n    await this.taskRepository.delete({\n      vps: { id: vpsId }\n    });\n  }\n\n  createLabelsData(rawVps: IRawVps[]): LabelsData {\n    const labelsData: LabelsData = {\n      [TasksLabels.EXPIRED]: 0,\n      [TasksLabels.MISSING]: 0,\n      [TasksLabels.RECHARGE]: 0,\n      [TasksLabels.RENEWAL]: 0,\n      [TasksLabels.ROLLOVER]: 0\n    };\n\n    rawVps.map((vps) => {\n      if (vps.timer <= 5) labelsData[TasksLabels.ROLLOVER]++;\n      if (vps.task_label) labelsData[vps.task_label]++;\n    });\n\n    return labelsData;\n  }\n\n  getLabel(taskType: TaskTypes, due_date: Date | undefined): TasksLabels | undefined {\n    switch (taskType) {\n      case TaskTypes.WALLET_THRESHOLD:\n        return TasksLabels.RECHARGE;\n      case TaskTypes.MISSING_BACKUP:\n        return TasksLabels.MISSING;\n      case TaskTypes.RENEW_SERVER:\n        if (!due_date) return;\n        const daysLeft = calculateDaysTimeDiff(due_date);\n        if (daysLeft >= 0 && daysLeft <= 5) return TasksLabels.RENEWAL;\n        else if (daysLeft < 0) return TasksLabels.EXPIRED;\n        return;\n      default:\n        return;\n    }\n  }\n  async getAllClusterNames() {\n    const tasksQB = this.taskRepository\n      .createQueryBuilder('task')\n      .leftJoinAndSelect('task.environment', 'environment')\n      .select(['environment.id as id', 'environment.name as name'])\n      .groupBy('environment.id');\n\n    return tasksQB.getRawMany();\n  }\n}\n\n\n\n\nimport {  Body, Controller, Get, Logger, Param, ParseEnumPipe, ParseIntPipe, Post, Put, Query, Req, UploadedFile, UseInterceptors } from '@nestjs\/common';\nimport { ApiOperation, ApiResponse, ApiTags } from '@nestjs\/swagger';\nimport { VpsService } from '.\/vps.service';\nimport { QueryDto } from '..\/..\/..\/query-builder\/query.dto';\nimport { ComponentsNames, IRawVps, IResponseGetVps, IVpsVendor, ProductTypeEnum } from '@rubi\/types';\nimport { Vps } from '.\/vps.entity';\nimport { ChangeStatusDto, CreateManyVpsDto, MoveVpsComponentDto, RenewVpsExpiryDateDto, UpdateVpsDto } from '.\/vps.dto';\nimport { RequestWithUserId } from '..\/..\/..\/middleware\/types';\nimport { FileInterceptor } from '@nestjs\/platform-express';\nimport { excelToJson } from 'apps\/core-service\/src\/utils\/export-to-excel';\n\n\n\n@ApiTags('Vps')\n@Controller('vps')\nexport class VpsController {\n  constructor(private readonly vpsService: VpsService) {}\n\n  @Post('query\/:environment_id')\n  @ApiOperation({ summary: 'get vps data' })\n  getVpByEnv(\n    @Param('environment_id', ParseIntPipe) environment_id: number,\n    @Body() body: QueryDto\n  ): Promise<IResponseGetVps> {\n    Logger.log(`VpsController:  getVpByEnv - Get related vps`);\n    return this.vpsService.getVpsByEnvironmentId(environment_id, body);\n  }\n\n  @Post('query')\n  @ApiOperation({ summary: 'get vps data' })\n  getVps(\n    @Body() body: QueryDto,\n    @Req() req:RequestWithUserId\n  ): Promise<{data:IRawVps[],total:number}> {\n    Logger.log(`VpsController: getVps - Get vps`);\n    return this.vpsService.getVps( body,req.user.id);\n  }\n\n  @Post('\/')\n  @ApiOperation({ summary: 'create many vps' })\n  @ApiResponse({ type: Array<Vps> })\n  createManyVps(   @Req() req:RequestWithUserId,@Body() body: CreateManyVpsDto): Promise<Vps[]> {\n    Logger.log(`VpsController: createManyVps - Creating many vps`);\n    return this.vpsService.createManyVps(req.user.id,body.vpss, body.componentId, body.site);\n  }\n  \n  @Put('renew_expiry_date\/:id')\n  @ApiOperation({ summary: 'update vps expiry date' })\n  @ApiResponse({ type: Vps })\n  renewExpiryDate(@Param('id', ParseIntPipe) id: number, @Body() body: RenewVpsExpiryDateDto): Promise<Vps> {\n    Logger.log(`VpsController: renewExpiryDate - Renew vps expiry date`);\n    return this.vpsService.renewVpsExpiryDate(id, body);\n  }\n\n\n  @Put('\/:id')\n  @ApiOperation({ summary: 'update vps' })\n  @ApiResponse({ type: Vps })\n  updateVps(@Param('id', ParseIntPipe) id: number, @Body() body: UpdateVpsDto, @Req() req: RequestWithUserId\n): Promise<Vps> {\n    Logger.log(`VpsController: updateVps - Update vps data`);\n    return this.vpsService.updateVps(id, body, req.user.id);\n  }\n\n\n  @Put('change-status\/:id')\n  @ApiOperation({ summary: 'change vps data' })\n  @ApiResponse({ type: Vps })\n  changeVpsStatus(\n   @Req() req:RequestWithUserId,\n    @Param('id', ParseIntPipe) id: number,\n    @Body() body: ChangeStatusDto\n  ): Promise<Vps> {\n    Logger.log(`VpsController: changeVpsStatus - Change vps status`);\n    return this.vpsService.changeStatus(id, body,req.user.id);\n  }\n\n  @Put('move-component\/:id')\n  @ApiOperation({ summary: 'move vps to another component' })\n  @ApiResponse({ type: Vps })\n  moveVpsToComponent(\n    @Req() req: RequestWithUserId,\n    @Param('id', ParseIntPipe) id: number,\n    @Body() body: MoveVpsComponentDto\n  ): Promise<Vps> {\n    Logger.log(`VpsController: moveVpsToComponent - Move vps to another component`);\n    return this.vpsService.moveVpsToComponent(id, body, req.user.id);\n  }\n\n\n  @Get('vendor')\n  @ApiOperation({ summary: 'get vendor data' })\n  getVendorsVpsName(\n  ): Promise<IVpsVendor[]> {\n    Logger.log(`VpsController: getVps - Get related vps`);\n    return this.vpsService.getVendorVpsNames();\n  }\n\n  @Get('get-available-server-ips\/:id')\n  @ApiOperation({ summary: 'get available servers to connect to mac minis' })\n  getAvailableServerIps(\n    @Param('id', ParseIntPipe) id: number,\n  ) {\n    Logger.log(`VpsController: getAvailableServerIps - Get available servers to connect to mac minis`);\n    return this.vpsService.getAvailableServerIps(id);\n  }\n\n  @Get('get-available-near-ips\/:id')\n  @ApiOperation({ summary: 'get available near ips to connect to raspberry' })\n  getAvailableNearIps(\n    @Param('id', ParseIntPipe) id: number,\n  ) {\n    Logger.log(`VpsController: getAvailableNearIps - Get available near ips to connect to raspberry`);\n    return this.vpsService.getAvailableNearIps(id);\n  }\n\n  @Get('get-available-far-attacker-ips\/:id')\n  @ApiOperation({ summary: 'get available far attacker ips to connect to raspberry' })\n  getAvailableFarAttackerIps(\n    @Param('id', ParseIntPipe) id: number,\n  ) {\n    Logger.log(`VpsController: getAvailableFarAttackerIps - Get available far attacker ips to connect to raspberry`);\n    return this.vpsService.getAvailableFarAttackerIps(id);\n  }\n\n  @Get('get-available-chains\/:envId\/:component')\n  @ApiOperation({ summary: 'get available far attacker ips to connect to raspberry' })\n  getAvailableChains(\n    @Param('envId', ParseIntPipe) envId: number,\n    @Param('component', new ParseEnumPipe(ComponentsNames)) component: ComponentsNames,\n  ) {\n    Logger.log(`VpsController: getAvailableFarAttackerIps - Get available far attacker ips to connect to raspberry`);\n    return this.vpsService.getUnusedChainPositions(envId,component);\n  }\n\n  @Get('get-available-positions\/:componentId\/:productType')\n  @ApiOperation({ summary: 'get available positions by component id' })\n  getAvailablePositions(\n    @Param('componentId', ParseIntPipe) componentId: number,\n    @Param('productType', new ParseEnumPipe(ProductTypeEnum)) productType: ProductTypeEnum,\n    @Query('excludeVpsId') excludeVpsId?: string\n  ) {\n    Logger.log(`VpsController: getAvailablePositions - Get available positions `);\n    return this.vpsService.getAvailablePositions(productType,componentId, excludeVpsId ? +excludeVpsId : undefined);\n  }\n\n\n  @Get('check-ip-exists')\n  @ApiOperation({ summary: 'check if ip already in use' })\n  getCheckIsIpExists(\n    @Query('ip') ip: string,\n    @Query('id') id?: number,\n\n  ) {\n    Logger.log(`VpsController: getCheckIsIpExists - check if ip already in use`);\n    return this.vpsService.checkIsIpExists(ip,id);\n  }\n\n  @Post('upload-bulk')\n  @UseInterceptors(FileInterceptor('file'))\n  async uploadExcel(@UploadedFile() file: any) {\n const jsonFromFile = excelToJson(file)\n await this.vpsService.uploadOldVpsByBulk(jsonFromFile)\n  }\n}\n\n\n\n\nimport { InjectRepository } from '@nestjs\/typeorm';\nimport { Vps } from '.\/vps.entity';\nimport { DataSource, Repository } from 'typeorm';\nimport _, { isEmpty } from 'lodash';\nimport { QueryDto } from '..\/..\/..\/query-builder\/query.dto';\nimport { defaultVpsRelations, selectedValueVpsDataFirstStep } from '.\/vps.const';\nimport { QueryBuilder } from '..\/..\/..\/query-builder\/query-builder';\nimport {\n  IComponentLabelsDataResponse,\n  ComponentsNames,\n  IRawVps,\n  IResponseGetVps,\n  IResponseVpsByComponent,\n  TaskTypes,\n  vpsFilterableFields,\n  VpsStatus,\n  IAvailableVpsIps,\n  ProductTypeEnum,\n  IAvailableAndDisablePositions,\n  Departments,\n  PositionTypeEnum\n} from '@rubi\/types';\nimport {\n  ChangeStatusDto,\n  CreateVpsDto,\n  MoveVpsComponentDto,\n  RenewVpsExpiryDateDto,\n  UpdateVpsDto\n} from '.\/vps.dto';\nimport { BadRequestException, Logger } from '@nestjs\/common';\nimport { VpsVendorService } from '.\/vpsVendor\/vpsVendor.service';\nimport { Component } from '..\/..\/environment-service\/component\/component.entity';\nimport { ComponentService } from '..\/..\/environment-service\/component\/component.service';\nimport { TaskService } from '..\/..\/task-service\/task\/task.service';\nimport { UserService } from '..\/..\/user-service\/user\/user.service';\nimport { isValidIP } from '..\/..\/..\/utils\/ipValidate';\nimport { getCount } from 'apps\/core-service\/src\/utils\/getCount';\nimport { ComponentTemplateService } from '..\/..\/environment-service\/componentTemplate\/componentTemplate.service';\nimport { StorageService } from '..\/..\/storage-service\/storage.service';\n\nexport class VpsService {\n  constructor(\n    @InjectRepository(Vps) private vpsRepository: Repository<Vps>,\n    private readonly componentService: ComponentService,\n    private readonly componentTemplateService: ComponentTemplateService,\n    private readonly vendorService: VpsVendorService,\n    private readonly taskService: TaskService,\n    private readonly userService: UserService,\n    private readonly dataSource: DataSource,\n    private readonly storageService: StorageService\n  ) {}\n  async findOneById(id: number, relations: string[] = defaultVpsRelations): Promise<Vps> {\n    const vps = await this.vpsRepository.findOne({\n      where: { id },\n      relations: relations\n    });\n    if (!vps) {\n      Logger.error(`VpsService: findById - vps with id: ${id} not found`);\n      throw new BadRequestException(`vps with id: ${id} not found`);\n    }\n    return vps;\n  }\n\n  private parseLabelsForComponent(\n    componentMinBackups: number,\n    inUseRawVps: IRawVps[] = [],\n    backupRawVps: IRawVps[] = []\n  ): IComponentLabelsDataResponse {\n    \/\/ In-use - Renew and expired\n    const inUseLabelsData = this.taskService.createLabelsData(inUseRawVps);\n\n    \/\/ Combined labels data for backups\n    const backupLabelsData = this.taskService.createLabelsData(backupRawVps);\n\n    return {\n      inUse: inUseLabelsData,\n      backup: {\n        ...backupLabelsData,\n        missing: Math.max(componentMinBackups - backupRawVps.length, 0)\n      }\n    };\n  }\n\n  private async convertGetVpsData(\n    rawData: IRawVps[],\n    allComponents: Component[]\n  ): Promise<IResponseGetVps> {\n    const vpsWithFiles = await Promise.all(\n      rawData.map(async (vps) => {\n        if (!vps.file_id) return vps;\n        const fileDetails = await this.storageService.generatePresignedUrl(vps.file_id);\n        return { ...vps, file: fileDetails };\n      })\n    );\n    const notInUse = _.remove(vpsWithFiles, (data) => data.current_status === VpsStatus.NOT_IN_USE);\n    const forCheck = _.remove(vpsWithFiles, (data) => data.current_status === VpsStatus.FOR_CHECK);\n    const groupByName = _.groupBy(vpsWithFiles, 'component_name');\n    const components = _.map(allComponents, (component) => {\n      const inUse = groupByName[component.name]\n        ? groupByName[component.name].filter((item) => item.current_status === VpsStatus.IN_USE)\n        : [];\n\n      const backup = groupByName[component.name]\n        ? groupByName[component.name].filter((item) => item.current_status === VpsStatus.BACKUP)\n        : [];\n      return {\n        component: {\n          name: component.name,\n          id: component.id,\n          profileId: component.profile ? component.profile.id : undefined,\n          labels: this.parseLabelsForComponent(component.min_backups, inUse, backup),\n          lastMovedAt: component.last_moved_at\n        },\n        vpsData: {\n          inUse,\n          backup\n        }\n      } as unknown as IResponseVpsByComponent;\n    });\n\n    const data: IResponseGetVps = {\n      components: components,\n      notInUse: notInUse,\n      forCheck: forCheck\n    };\n\n    return data;\n  }\n\n  async getVpsByEnvironmentId(environmentId: number, query: QueryDto) {\n    const components: Component[] = await this.componentService.getComponentsOrderByEnvType(\n      environmentId\n    );\n    const finalQuery = this.getVpsQuery(query, false, environmentId).orderBy('vps.id', 'ASC');\n    const rawData = await finalQuery.getRawMany<IRawVps>();\n    return this.convertGetVpsData(rawData, components);\n  }\n\n  getVpsQuery(query: QueryDto, filterByUSBase: boolean, environmentId?: number) {\n    const vpsQB = this.vpsRepository\n      .createQueryBuilder('vps')\n      .leftJoinAndSelect('vps.component', 'component')\n      .leftJoinAndSelect('vps.vendor', 'vendor')\n      .leftJoinAndSelect('component.environment', 'environment')\n      .leftJoinAndSelect('environment.client', 'client')\n      .leftJoinAndSelect('environment.owner', 'owner')\n      .leftJoin('vps.moved_from_component', 'movedFromComponent')\n      .leftJoin('movedFromComponent.environment', 'movedFromEnvironment')\n      .leftJoin('movedFromComponent.profile', 'movedFromProfile')\n      .leftJoin('vps.mac_mini', 'mac_mini')\n      .leftJoin('vps.raspberrypi_near', 'raspberrypi_near')\n      .leftJoin('vps.raspberrypi_far_attacker', 'raspberrypi_far_attacker')\n      .leftJoin('vps.note_updated_by', 'noteUpdatedBy')\n      .select(selectedValueVpsDataFirstStep);\n\n    if (filterByUSBase) {\n      vpsQB.andWhere('client.us_based = :usBased', { usBased: true });\n    }\n    if (environmentId) {\n      vpsQB.andWhere('environment.id = :environmentId', { environmentId });\n    }\n    const queryBuilder = new QueryBuilder(vpsQB);\n    return queryBuilder.applyQuery(query, vpsFilterableFields);\n  }\n\n  async getVps(query: QueryDto, userId: number) {\n    const userDetails = await this.userService.findById(userId);\n    const filterByUsBase = userDetails.department.name === Departments.TAM_US;\n    const finalQuery = this.getVpsQuery(query, filterByUsBase);\n    const total = await getCount(this.dataSource, finalQuery);\n    const instanceQueryBuilderToPagination = new QueryBuilder(finalQuery);\n    const paginatedQuery = instanceQueryBuilderToPagination.applyPagination(query);\n    const data = await paginatedQuery.getRawMany<IRawVps>();\n    return { total, data };\n  }\n\n  async createManyVps(userId: number, vpss: CreateVpsDto[], componentId: number, vendorId: number) {\n    if (_.isEmpty(vpss)) {\n      Logger.error(`VpsService: createManyVps - Empty array of vpss`);\n      throw new BadRequestException(`Empty Array`);\n    }\n\n    const [component, vendor, user] = await Promise.all([\n      this.componentService.findById(componentId),\n      this.vendorService.findOneById(vendorId),\n      this.userService.findById(userId)\n    ]);\n\n    const vpsData = vpss.map((vps) => {\n      return {\n        ...vps,\n        current_status: VpsStatus.BACKUP,\n        component: component,\n        vendor: vendor,\n        moved_by: user\n      };\n    });\n    const res = await this.vpsRepository.save(vpsData);\n\n    \/\/ Creating renew task for each vps\n    await Promise.all(res.map((vps) => this.createRenewTask(vps)));\n\n    return res;\n  }\n\n  private async createRenewTask(vps: Vps) {\n    if (!vps.component?.id) {\n      Logger.error(`VpsService: createRenewTask - vps component id is undefined`);\n      throw new BadRequestException(`vps component id is undefined`);\n    }\n    const component = await this.componentService.findById(vps.component?.id);\n\n    await this.taskService.createTask<Vps>(\n      vps,\n      component.environment,\n      TaskTypes.RENEW_SERVER,\n      vps.expiry_date\n    );\n  }\n\n  private async createTaskPerStatus(newStatus: VpsStatus, vps: Vps) {\n    if (!vps.component?.id) {\n      Logger.error(`VpsService: createTaskPerStatus - component id is undefined`);\n      throw new BadRequestException(`component id is undefined`);\n    }\n\n    const component = await this.componentService.findById(vps.component?.id);\n    let taskType: TaskTypes | null;\n    switch (newStatus) {\n      case VpsStatus.FOR_CHECK:\n        taskType = TaskTypes.SERVER_UNDER_INSPECTION;\n        break;\n      case VpsStatus.NOT_IN_USE:\n        await this.taskService.removeTasksByVpsId(vps.id);\n        taskType = TaskTypes.SERVER_NO_LONGER_IN_USE;\n        break;\n      default:\n        taskType = null;\n    }\n    if (taskType) await this.taskService.createTask<Vps>(vps, component.environment, taskType);\n  }\n\n  async updateVps(vpsId: number, dto: UpdateVpsDto, userId?: number) {\n    const vps = await this.findOneById(vpsId);\n\n    const isNoteUpdated = dto.note !== undefined && dto.note !== vps.note;\n\n    Object.assign(\n      vps,\n      Object.fromEntries(Object.entries(dto).filter(([_, value]) => value !== undefined))\n    );\n\n    if (isNoteUpdated) {\n      vps.note_updated_at = new Date();\n\n      if (userId) {\n        vps.note_updated_by = await this.userService.findById(userId);\n      }\n    }\n\n    if (dto.expiry_date) {\n      this.taskService.updateVpsLastTask(vps);\n    }\n\n    if (dto.site_id) {\n      const vendor = await this.vendorService.findOneById(dto.site_id);\n      Object.assign(vps, { vendor });\n    }\n\n    return this.vpsRepository.save(vps);\n  }\n\n  async renewVpsExpiryDate(vpsId: number, dto: RenewVpsExpiryDateDto) {\n    const vps = await this.findOneById(vpsId);\n    vps.expiry_date = dto.expiry_date;\n\n    const updatedVps = await this.vpsRepository.save(vps);\n\n    await this.createRenewTask(updatedVps);\n\n    return updatedVps;\n  }\n\n  async changeStatus(vpsId: number, dto: ChangeStatusDto, userId: number) {\n    const vps = await this.findOneById(vpsId, ['component']);\n\n    if (vps.current_status === VpsStatus.NOT_IN_USE) {\n      Logger.error(`VpsService: moveServer - can't change status of server if it  not in use`);\n      throw new BadRequestException(`Can't change status of server if it  not in use`);\n    }\n    if (vps.current_status === dto.new_status) {\n      Logger.error(`VpsService: moveServer - the status is the same `);\n      throw new BadRequestException(`The status: ${vps.current_status} is the same`);\n    }\n    if (vps.current_status === VpsStatus.IN_USE && dto.new_status === VpsStatus.BACKUP) {\n      Logger.error(`VpsService: moveServer - can't change from in use to backup `);\n      throw new BadRequestException(`Can't change from in use to backup`);\n    }\n\n    \/\/ Create tasks per status\n    await this.createTaskPerStatus(dto.new_status, vps);\n    const moved_by = await this.userService.findById(userId);\n\n    Object.assign(vps, {\n      last_status: vps.current_status,\n      current_status: dto.new_status,\n      change_status_reason: dto.reason,\n      change_status_date: new Date(),\n      moved_by,\n      position: dto.new_status === VpsStatus.IN_USE ? dto.position : vps.position,\n      mac_mini:\n        dto.new_status === VpsStatus.NOT_IN_USE || dto.new_status === VpsStatus.FOR_CHECK\n          ? null\n          : vps.mac_mini,\n      raspberrypi_near:\n        dto.new_status === VpsStatus.NOT_IN_USE || dto.new_status === VpsStatus.FOR_CHECK\n          ? null\n          : vps.raspberrypi_near,\n      raspberrypi_far_attacker:\n        dto.new_status === VpsStatus.NOT_IN_USE || dto.new_status === VpsStatus.FOR_CHECK\n          ? null\n          : vps.raspberrypi_far_attacker\n    });\n\n    const updatedVps = await this.vpsRepository.save(vps);\n\n    \/\/ Validate min backups of the component\n    await this.componentService.validateMinBackups(vps.component?.id);\n\n    return updatedVps;\n  }\n\n  async moveVpsToComponent(vpsId: number, dto: MoveVpsComponentDto, userId: number): Promise<Vps> {\n    const vps = await this.findOneById(vpsId, [\n      'component',\n      'component.environment',\n      'mac_mini',\n      'raspberrypi_near',\n      'raspberrypi_far_attacker'\n    ]);\n\n    if (!vps.component?.id) {\n      Logger.error(`VpsService: moveVpsToComponent - source component is missing`);\n      throw new BadRequestException('Source component is missing');\n    }\n\n    const sourceComponent = vps.component;\n    const destinationComponent = await this.componentService.findById(dto.destinationComponentId);\n    const movedBy = await this.userService.findById(userId);\n\n    if (sourceComponent.id === destinationComponent.id) {\n      Logger.error(`VpsService: moveVpsToComponent - source and destination are the same`);\n      throw new BadRequestException('Source and destination components are the same');\n    }\n\n    const destinationComponentTemplate =\n      await this.componentTemplateService.getComponentsTemplateByProductTypeAndName(\n        destinationComponent.environment.type,\n        destinationComponent.name\n      );\n\n    const destinationPositions =\n      destinationComponentTemplate?.positions ?? destinationComponent.positions ?? [];\n\n    const vpsPositions = destinationPositions.filter(\n      (position) => !position.type || position.type === PositionTypeEnum.VPS\n    );\n\n    if (vpsPositions.length > 0 && !dto.position) {\n      Logger.error(`VpsService: moveVpsToComponent - position is required`);\n      throw new BadRequestException('Position is required');\n    }\n\n    if (dto.position && vpsPositions.length > 0) {\n      const isPositionExists = vpsPositions.some((position) => position.name === dto.position);\n\n      if (!isPositionExists) {\n        Logger.error(`VpsService: moveVpsToComponent - position does not exist on component`);\n        throw new BadRequestException('Position does not exist on destination component');\n      }\n    }\n\n    const selectedPosition = dto.position\n      ? vpsPositions.find((position) => position.name === dto.position)\n      : undefined;\n\n    if (vps.current_status === VpsStatus.IN_USE && selectedPosition?.is_unique) {\n      const existingVpsWithSamePosition = destinationComponent.vps?.find(\n        (destinationVps) =>\n          destinationVps.id !== vps.id &&\n          destinationVps.current_status === VpsStatus.IN_USE &&\n          destinationVps.position === dto.position\n      );\n\n      if (existingVpsWithSamePosition) {\n        Logger.error(`VpsService: moveVpsToComponent - position already used`);\n        throw new BadRequestException('Position is already used by another In Use VPS');\n      }\n    }\n\n    const nextPosition =\n      vpsPositions.length > 0\n        ? dto.position\n        : vps.current_status === VpsStatus.BACKUP\n        ? 'backup'\n        : null;\n\n    Object.assign(vps, {\n      component: destinationComponent,\n      moved_from_component: sourceComponent,\n      moved_at: new Date(),\n      moved_by: movedBy,\n      position: nextPosition\n    });\n\n    const updatedVps = await this.vpsRepository.save(vps);\n\n    await Promise.all([\n      this.componentService.validateMinBackups(sourceComponent.id),\n      this.componentService.validateMinBackups(destinationComponent.id)\n    ]);\n\n    return updatedVps;\n  }\n\n  async getVendorVpsNames() {\n    return this.vendorService.getAllNames();\n  }\n\n  async getAvailableServerIps(id: number): Promise<IAvailableVpsIps[]> {\n    Logger.log(`${VpsService.name}: getAvailableServerIps - fetching available white jasmino vpss`);\n    const availableVpss = await this.vpsRepository\n      .createQueryBuilder('vps')\n      .leftJoinAndSelect('vps.component', 'component')\n      .leftJoinAndSelect('component.environment', 'environment')\n      .leftJoin('vps.mac_mini', 'mac_mini')\n      .select(['vps.id AS id', 'vps.ip AS ip'])\n      .where('environment.id = :id', { id })\n      .andWhere(`component.name = '${ComponentsNames.WHITE_JASMINO}'`)\n      .andWhere(`vps.current_status = '${VpsStatus.IN_USE}'`)\n      .andWhere('mac_mini.id IS NULL')\n      .getRawMany<IAvailableVpsIps>();\n    return availableVpss;\n  }\n\n  async getAvailableNearIps(id: number): Promise<IAvailableVpsIps[]> {\n    Logger.log(`${VpsService.name}: getAvailableNearIps - fetching available near vpss`);\n    const availableVpss = await this.vpsRepository\n      .createQueryBuilder('vps')\n      .leftJoinAndSelect('vps.component', 'component')\n      .leftJoinAndSelect('component.environment', 'environment')\n      .leftJoin('vps.raspberrypi_near', 'raspberrypi_near')\n      .select(['vps.id AS id', `CONCAT(vps.ip,' - ',vps.position) AS ip`])\n      .where('environment.id = :id', { id })\n      .andWhere(`component.name = '${ComponentsNames.NEAR}'`)\n      .andWhere(`vps.current_status = '${VpsStatus.IN_USE}'`)\n      .andWhere('raspberrypi_near.id IS NULL')\n      .getRawMany<IAvailableVpsIps>();\n    return availableVpss;\n  }\n\n  async getAvailableFarAttackerIps(id: number): Promise<IAvailableVpsIps[]> {\n    Logger.log(\n      `${VpsService.name}: getAvailableFarAttackerIps - fetching available far atacker vpss`\n    );\n    const availableVpss = await this.vpsRepository\n      .createQueryBuilder('vps')\n      .leftJoinAndSelect('vps.component', 'component')\n      .leftJoinAndSelect('component.environment', 'environment')\n      .leftJoin('vps.raspberrypi_far_attacker', 'raspberrypi_far_attacker')\n      .select(['vps.id AS id', `CONCAT(vps.ip,' - ',vps.position) AS ip`])\n      .where('environment.id = :id', { id })\n      .andWhere(`component.name = '${ComponentsNames.FAR_ATTACKER}'`)\n      .andWhere(`vps.current_status = '${VpsStatus.IN_USE}'`)\n      .andWhere('raspberrypi_far_attacker.id IS NULL')\n      .getRawMany<IAvailableVpsIps>();\n    return availableVpss;\n  }\n\n  async getAvailableWhiteSwiftIpsForAttacker(\n    id: number,\n    excludeIds: number[]\n  ): Promise<IAvailableVpsIps[]> {\n    Logger.log(\n      `${VpsService.name}: getAvailableWhiteSwiftIps - fetching available far atacker vpss`\n    );\n    const availableVpss = this.vpsRepository\n      .createQueryBuilder('vps')\n      .leftJoinAndSelect('vps.component', 'component')\n      .leftJoinAndSelect('component.environment', 'environment')\n      .select(['vps.id AS id', 'vps.ip AS ip'])\n      .where('environment.id = :id', { id })\n      .andWhere(`component.name = '${ComponentsNames.WHITE_SWIFT}'`)\n      .andWhere(`vps.current_status = '${VpsStatus.IN_USE}'`);\n\n    if (excludeIds.length > 0) {\n      availableVpss.andWhere(`vps.id NOT IN (:...excludeIds)`, { excludeIds });\n    }\n    return availableVpss.getRawMany<IAvailableVpsIps>();\n  }\n\n  async getUnusedChainPositions(\n    environmentId: number,\n    component: ComponentsNames\n  ): Promise<string[]> {\n    const usePositions = await this.vpsRepository\n      .createQueryBuilder('vps')\n      .leftJoinAndSelect('vps.component', 'component')\n      .leftJoinAndSelect('component.environment', 'environment')\n      .where('component.name = :name', { name: component })\n      .andWhere('environment.id = :id', { id: environmentId })\n      .andWhere('vps.position::text LIKE :prefix', { prefix: 'chain%' })\n      .select('DISTINCT vps.position', 'position')\n      .getRawMany();\n\n    return usePositions.map((data) => data.position);\n  }\n\n  async getAvailablePositions(\n    productType: ProductTypeEnum,\n    componentId: number,\n    excludeVpsId?: number\n  ): Promise<IAvailableAndDisablePositions> {\n    const component = await this.componentService.findById(componentId);\n    const componentTemplate =\n      await this.componentTemplateService.getComponentsTemplateByProductTypeAndName(\n        productType,\n        component.name\n      );\n\n    const sourcePositions = componentTemplate?.positions ?? component.positions ?? [];\n    const isInitialWithPosition =\n      componentTemplate?.backup_position ?? component.backup_position ?? false;\n\n    if (!sourcePositions.length) {\n      return {\n        available: [],\n        disable: [],\n        is_initial_with_position: isInitialWithPosition\n      };\n    }\n\n    const vpsPositions = sourcePositions.filter(\n      (position) => !position.type || position.type === PositionTypeEnum.VPS\n    );\n\n    const uniquePositions = vpsPositions\n      .filter((position) => position.is_unique)\n      .map((position) => position.name);\n\n    const nonUniquePositions = vpsPositions\n      .filter((position) => !position.is_unique)\n      .map((position) => position.name);\n    if (isEmpty(uniquePositions))\n      return {\n        available: nonUniquePositions,\n        disable: [],\n        is_initial_with_position: isInitialWithPosition\n      };\n    const existsPositions = component.vps\n      ?.filter((vps) => vps.id !== excludeVpsId)\n      ?.filter((vps) => vps.current_status === VpsStatus.IN_USE)\n      .map((vps) => vps.position)\n      .filter(Boolean);\n    const availablePositions = uniquePositions.filter(\n      (position) => !existsPositions?.includes(position as unknown as any)\n    );\n    const disablePositions = uniquePositions.filter((position) =>\n      existsPositions?.includes(position as unknown as any)\n    );\n    return {\n      available: [...availablePositions, ...nonUniquePositions],\n      disable: disablePositions,\n      is_initial_with_position: isInitialWithPosition\n    };\n  }\n\n  async checkIsIpExists(ip: string, id?: number): Promise<boolean> {\n    const query = this.vpsRepository.createQueryBuilder('vps').where('vps.ip = :ip', { ip });\n\n    if (id) query.andWhere('vps.id != :id', { id });\n\n    return query.getExists();\n  }\n\n  async uploadOldVpsByBulk(vpss: any[]) {\n    const vpssToInsert = await Promise.all(\n      vpss.map(async (vps) => {\n        const { vendor_id, component_id, expiry_date, ...rest } = vps;\n        const vendor = await this.vendorService.findOneById(vendor_id);\n        const component = await this.componentService.findById(component_id);\n        const [day, month, year] = (expiry_date as unknown as string).toString().split('\/');\n        const date = new Date(`${year}-${month}-${day}`);\n        if (!isValidIP(rest.ip)) {\n          throw new BadRequestException(`ip ${rest.ip} not valid`);\n        }\n        return {\n          ...rest,\n          vendor,\n          component,\n          expiry_date: date\n        };\n      })\n    );\n    try {\n      const res = await this.vpsRepository.save(vpssToInsert);\n      Logger.log(`successfully update bulk of vps`);\n      return res;\n    } catch (e) {\n      Logger.error('error in update bulk vps', e);\n    }\n  }\n}\n\n\n\n\nimport { Body, Controller, Get, Param, ParseIntPipe, Post, Put } from '@nestjs\/common';\nimport { ApiOperation, ApiResponse, ApiTags } from '@nestjs\/swagger';\nimport { ProfileService } from '.\/profile.service';\nimport { AttackerProfile, Profile } from '.\/profile.entity';\nimport {\n  CreateAttackerProfileDto,\n  CreateProfileDto,\n  EditAttackerAccountDto,\n  EditAttackerPaymentDto,\n  EditAttackerPhoneDto,\n  UpdateProfileDto\n} from '.\/profile.dto';\n\n@ApiTags('Profile')\n@Controller('profile')\nexport class ProfileController {\n  constructor(private readonly profileService: ProfileService) {}\n\n  @Put('account\/:id')\n  @ApiOperation({ summary: 'update attacker profile account ' })\n  @ApiResponse({ type: Profile })\n  updateAttackerProfileAccount(\n    @Param('id', ParseIntPipe) id: number,\n    @Body() body: EditAttackerAccountDto\n  ): Promise<void> {\n    return this.profileService.updateAttackerProfileAccount(id, body);\n  }\n\n  @Post('\/')\n  @ApiOperation({ summary: 'create new profile' })\n  @ApiResponse({ type: Profile })\n  createProfile(@Body() body: CreateProfileDto): Promise<Profile> {\n    const entityId = body.entity_to_connect_id;\n    const entityType = body.entity_type;\n    return this.profileService.createProfile(body, entityId, entityType);\n  }\n\n  @Post('\/attacker')\n  @ApiOperation({ summary: 'create new profile' })\n  @ApiResponse({ type: Profile })\n  CreateAttackerProfile(@Body() body: CreateAttackerProfileDto): Promise<AttackerProfile> {\n    return this.profileService.createAttackerProfile(body);\n  }\n\n  @Put('\/:id')\n  @ApiOperation({ summary: 'update profile' })\n  @ApiResponse({ type: Profile })\n  updateProfile(\n    @Param('id', ParseIntPipe) id: number,\n    @Body() body: UpdateProfileDto\n  ): Promise<void> {\n    return this.profileService.updateProfile(id, body);\n  }\n\n  @Get('\/:id')\n  @ApiOperation({ summary: 'get profile details by id' })\n  @ApiResponse({ type: Profile })\n  getProfileDetails(@Param('id', ParseIntPipe) id: number) {\n    return this.profileService.getProfileDetailsById(id);\n  }\n\n  @Put('payment\/:id')\n  @ApiOperation({ summary: 'update attacker profile pament' })\n  @ApiResponse({ type: Profile })\n  updateAttackerProfilePayment(\n    @Param('id', ParseIntPipe) id: number,\n    @Body() body: EditAttackerPaymentDto\n  ): Promise<void> {\n    return this.profileService.updateAttackerProfilePayment(id, body);\n  }\n\n  @Put('phone\/:id')\n  @ApiOperation({ summary: 'update attacker profile phone ' })\n  @ApiResponse({ type: Profile })\n  updateAttackerProfilePhone(\n    @Param('id', ParseIntPipe) id: number,\n    @Body() body: EditAttackerPhoneDto\n  ): Promise<void> {\n    return this.profileService.updateAttackerProfilePhone(id, body);\n  }\n}\n\n\n\nimport {\n  BadRequestException,\n  forwardRef,\n  Inject,\n  Injectable,\n  InternalServerErrorException,\n  Logger\n} from '@nestjs\/common';\nimport { DataSource, Repository } from 'typeorm';\nimport { AttackerProfile, Profile } from '.\/profile.entity';\nimport { cryptoTypeByProduct, EntityTypeToConnectToProfile, IWallet, ProfileTypes } from '@rubi\/types';\nimport { ComponentService } from '..\/..\/environment-service\/component\/component.service';\nimport { EnvironmentService } from '..\/..\/environment-service\/environment\/environment.service';\nimport {\n  AttackerAccountDto,\n  AttackerPaymentDto,\n  AttackerPhoneDto,\n  CreateAttackerProfileDto,\n  CreateProfileAndEmailDto,\n  CreateProfileDto,\n  EditAttackerAccountDto,\n  EditAttackerPaymentDto,\n  EditAttackerPhoneDto,\n  UpdateProfileDto\n} from '.\/profile.dto';\nimport { InjectRepository } from '@nestjs\/typeorm';\nimport { queryRunnerInitializer } from '..\/..\/..\/utils\/query-runner';\nimport { Wallet } from '..\/..\/wallet-service\/wallet\/wallet.entity';\nimport { isEmpty } from 'lodash';\nimport { StorageService } from '..\/..\/storage-service\/storage.service';\nimport { EmailService } from '..\/email\/email.service';\nimport { CreateEmailDto } from '..\/email\/email.dto';\nimport { AttackerService } from '..\/..\/environment-service\/attacker\/attacker.service';\nimport {\n  AttackerProfileAccount,\n  AttackerProfilePayment,\n  AttackerProfilePhone\n} from '.\/attacker-profile-connections.entity';\nimport { errorsToClient } from 'apps\/core-service\/src\/const';\nimport { Email } from '..\/email\/email.entity';\n\n@Injectable()\nexport class ProfileService {\n  constructor(\n    @InjectRepository(Profile) private profileRepository: Repository<Profile>,\n    @InjectRepository(AttackerProfilePhone)\n    private attackerProfilePhoneRepository: Repository<AttackerProfilePhone>,\n    @InjectRepository(AttackerProfilePayment)\n    private attackerProfilePaymentRepository: Repository<AttackerProfilePayment>,\n    @InjectRepository(AttackerProfileAccount)\n    private attackerProfileAccountRepository: Repository<AttackerProfileAccount>,\n    private readonly environmentService: EnvironmentService,\n    private readonly componentService: ComponentService,\n    @Inject(forwardRef(() => EmailService))\n    private readonly emailService: EmailService,\n    private readonly storageService: StorageService,\n    private readonly attackerService: AttackerService,\n    private readonly dataSource: DataSource\n  ) {}\n\n  async findById(id: number): Promise<Profile> {\n    const profile = await this.profileRepository.findOne({\n      where: { id },\n      relations: ['component.environment', 'environment']\n    });\n    if (!profile) {\n      Logger.error(`ProfileService - Profile with ID ${id} not found`);\n      throw new BadRequestException(`Profile with ID ${id} not found`);\n    }\n    return profile;\n  }\n  async createProfile(\n    profile: CreateProfileDto,\n    entityId?: number,\n    entityType?: EntityTypeToConnectToProfile\n  ) {\n    const queryRunner = await queryRunnerInitializer(this.dataSource);\n\n    const { entity_to_connect_id, entity_type, ...profileToCreate } = profile;\n    try {\n      const createdProfile = await queryRunner.manager.save(Profile, profileToCreate);\n\n      if (entityId) {\n        if (entityType === EntityTypeToConnectToProfile.COMPONENT) {\n          await this.componentService.attachProfileToComponent(\n            entityId,\n            createdProfile,\n            queryRunner\n          );\n        } else if (entityType === EntityTypeToConnectToProfile.ENVIRONMENT) {\n          await this.environmentService.attachProfileToEnvironment(\n            entityId,\n            createdProfile,\n            queryRunner\n          );\n        }\n      }\n      await queryRunner.commitTransaction();\n      return createdProfile;\n    } catch (error) {\n      await queryRunner.rollbackTransaction();\n      Logger.error(error);\n      throw new InternalServerErrorException(errorsToClient.transaction);\n    } finally {\n      await queryRunner.release();\n    }\n  }\n\n  async createProfileAndEmail(body: CreateProfileAndEmailDto): Promise<Profile> {\n    const { email, email_password, email_recovery_phrase, ...profileData } = body;\n\n    const profile = await this.createProfile(profileData);\n\n    const emailToCreate: CreateEmailDto = {\n      mail: email,\n      password: email_password,\n      recovery_phrase: email_recovery_phrase,\n      profile_id: profile.id\n    };\n\n    await this.emailService.createEmail(emailToCreate);\n\n    return profile;\n  }\n\n  async updateProfile(id: number, fieldsToUpdate: UpdateProfileDto): Promise<void> {\n    await this.findById(id);\n    await this.profileRepository.update({ id }, { ...fieldsToUpdate });\n  }\n\n  async getEmptyProfileOfMainWallets(): Promise<Profile[]> {\n    return this.profileRepository\n      .createQueryBuilder('profile')\n      .leftJoinAndSelect('profile.wallets', 'wallet')\n      .where('wallet.id IS NULL')\n      .andWhere('profile.type = :type', { type: 'main' })\n      .getMany();\n  }\n\n  async getProfileDetailsById(id: number) {\n    const profile = await this.profileRepository.findOne({\n      where: { id },\n      relations: [\n        'wallets',\n        'wallets.email',\n        'wallets.wallet_provider',\n        'emails',\n        'bucket',\n        'air_account',\n        'credit_cards.sim',\n        'attackerPhone',\n        'attackerPayment',\n        'attackerAccount',\n        'credit_cards',\n        'credit_cards.email',\n        'sims',\n        'sims.provider',\n        'sims.provider.country',\n        'vps_accounts',\n        'vps_accounts.vps_vendor',\n        'manually_credit_cards',\n        'component.environment'\n      ]\n    });\n    if (!profile) return null;\n    let walletsWithFiles: IWallet[] = [];\n    if (profile?.wallets) {\n      walletsWithFiles = await this.getFiles(profile.wallets);\n      if (profile.type === ProfileTypes.COMPONENT){\n        const productType = profile?.component?.environment.type\n        if(productType){\n          const currencyType = cryptoTypeByProduct[productType]\n          walletsWithFiles = walletsWithFiles.map(wallet=>{\n            const needToUpdateCurrencyType = wallet.crypto_type !==currencyType\n            return {...wallet,needToUpdateCurrencyType}\n          })\n\n        }\n      \n      }\n    \n    }\n    return {\n      ...profile,\n      wallets: walletsWithFiles\n    };\n  }\n\n  async getFiles(wallets: Wallet[]): Promise<IWallet[]> {\n    return Promise.all(\n      wallets.map(async (wallet) => {\n        if (!isEmpty(wallet.seed)) return wallet as IWallet;\n        const fileDetails = await this.storageService.generatePresignedUrl(wallet.file_id!);\n        return { ...wallet, seed: fileDetails } as IWallet;\n      })\n    );\n  }\n\n  async createAttackerPhone(body: AttackerPhoneDto) {\n    return this.attackerProfilePhoneRepository.save(body);\n  }\n\n  async createAttackerPayment(body: AttackerPaymentDto) {\n    return this.attackerProfilePaymentRepository.save({ ...body });\n  }\n\n  async createAttackerAccount(body: AttackerAccountDto) {\n    return this.attackerProfileAccountRepository.save({ ...body });\n  }\n\n  async createAttackerProfile(body: CreateAttackerProfileDto) {\n    const { profile, phone, payment, attacker_id, account } = body;\n    const { mail, password, ...rest } = profile;\n    const queryRunner = await queryRunnerInitializer(this.dataSource);\n\n    try {\n      const attackerPhone = await queryRunner.manager.save(AttackerProfilePhone, phone);\n      const attackerPayment = await queryRunner.manager.save(AttackerProfilePayment, payment);\n      const attackerAccount = await queryRunner.manager.save(AttackerProfileAccount, account);\n      const attacker = await this.attackerService.findById(attacker_id);\n      const profileToCreate = {\n        ...rest,\n        type: ProfileTypes.ATTACKER,\n        attackerPhone,\n        attackerPayment,\n        attacker,\n        attackerAccount\n      };\n      const createdProfile = await queryRunner.manager.save(AttackerProfile, profileToCreate);\n      await queryRunner.manager.save(Email, { mail, password, profile_id: createdProfile.id });\n\n      await queryRunner.commitTransaction();\n      return createdProfile;\n    } catch (error) {\n      await queryRunner.rollbackTransaction();\n      Logger.error(error);\n      throw new InternalServerErrorException(errorsToClient.transaction);\n    } finally {\n      await queryRunner.release();\n    }\n  }\n\n  async findAttackerProfilePhoneById(id: number): Promise<AttackerProfilePhone> {\n    const phone = await this.attackerProfilePhoneRepository.findOne({\n      where: { id }\n    });\n    if (!phone) {\n      Logger.error(`ProfileService - phone with ID ${id} not found`);\n      throw new BadRequestException(`phone with ID ${id} not found`);\n    }\n    return phone;\n  }\n\n  async findAttackerProfilePaymentById(id: number): Promise<AttackerProfilePayment> {\n    const payment = await this.attackerProfilePaymentRepository.findOne({\n      where: { id }\n    });\n    if (!payment) {\n      Logger.error(`ProfileService - payment with ID ${id} not found`);\n      throw new BadRequestException(`payment with ID ${id} not found`);\n    }\n    return payment;\n  }\n\n  async findAttackerProfileAccountById(id: number): Promise<AttackerProfileAccount> {\n    const account = await this.attackerProfileAccountRepository.findOne({\n      where: { id }\n    });\n    if (!account) {\n      Logger.error(`ProfileService - account with ID ${id} not found`);\n      throw new BadRequestException(`account with ID ${id} not found`);\n    }\n    return account;\n  }\n\n  async updateAttackerProfilePayment(id: number, body: EditAttackerPaymentDto) {\n    await this.findAttackerProfilePaymentById(id);\n    await this.attackerProfilePaymentRepository.update({ id }, { ...body });\n  }\n\n  async updateAttackerProfilePhone(id: number, body: EditAttackerPhoneDto) {\n    await this.findAttackerProfilePhoneById(id);\n    await this.attackerProfilePhoneRepository.update({ id }, { ...body });\n  }\n\n  async updateAttackerProfileAccount(id: number, body: EditAttackerAccountDto) {\n    await this.findAttackerProfileAccountById(id);\n    await this.attackerProfileAccountRepository.update({ id }, { ...body });\n  }\n}\n\n\n\nimport { Body, Controller, Get, Logger, Param, ParseIntPipe, Post, Put } from '@nestjs\/common';\nimport { ApiBody, ApiOperation, ApiTags } from '@nestjs\/swagger';\nimport { ComponentService } from '.\/component.service';\nimport { IComponentNames } from '@rubi\/types';\nimport { ComponentDto, MoveComponentsDto } from '.\/component.dto';\n\n@ApiTags('Component')\n@Controller('component')\nexport class ComponentController {\n  constructor(private readonly componentService: ComponentService) {}\n\n  @Get('\/:environment_id')\n  @ApiOperation({ summary: 'get component by environment id' })\n  getComponentsByEnvId(\n    @Param('environment_id', ParseIntPipe) environment_id: number\n  ): Promise<IComponentNames[]> {\n    Logger.log(`ComponentController: getComponentsByEnvId - Get related components`);\n    return this.componentService.getComponentsByEnvId(environment_id);\n  }\n\n  @Post('\/:environment_id')\n  @ApiOperation({ summary: 'create custom component by env' })\n  createComponent(\n    @Param('environment_id', ParseIntPipe) environment_id: number,\n    @Body() body: ComponentDto\n  ) {\n    Logger.log(`ComponentController: create component by env id : ${environment_id}`);\n    return this.componentService.createComponent(body, environment_id);\n  }\n\n  @Put('\/move\/:environment_id')\n  @ApiOperation({ summary: 'Move components to another environment' })\n  @ApiBody({ type: MoveComponentsDto })\n  moveComponents(\n    @Param('environment_id', ParseIntPipe) environmentId: number,\n    @Body() body: MoveComponentsDto\n  ) {\n    return this.componentService.moveComponentsToEnvironment(body.componentIds, environmentId);\n  }\n}\n\n\n\nimport { BadRequestException, forwardRef, Inject, Injectable, Logger } from '@nestjs\/common';\nimport { InjectRepository } from '@nestjs\/typeorm';\nimport { DataSource, In, QueryRunner, Repository } from 'typeorm';\nimport { Component } from '.\/component.entity';\nimport { Environment } from '..\/..\/environment-service\/environment\/environment.entity';\nimport { Profile } from '..\/..\/profile-service\/profile\/profile.entity';\nimport { TaskService } from '..\/..\/task-service\/task\/task.service';\nimport { ComponentsNames, TaskProgressStatus, TaskTypes, VpsStatus } from '@rubi\/types';\nimport { getComponentsNameOrderByEnvType } from '..\/..\/..\/utils\/componentsOrder';\nimport { ComponentDto } from '.\/component.dto';\nimport { EnvironmentService } from '..\/environment\/environment.service';\nimport { moveNearOrFarComponent, moveWhiteJasmino } from '..\/..\/..\/utils\/move';\nimport { ComponentTemplate } from '..\/componentTemplate\/componentTemplate.entity';\n\n@Injectable()\nexport class ComponentService {\n  constructor(\n    private dataSource: DataSource,\n    @InjectRepository(Component) private componentRepository: Repository<Component>,\n    @InjectRepository(ComponentTemplate)\n    private componentTemplateRepository: Repository<ComponentTemplate>,\n    private readonly taskService: TaskService,\n    @Inject(forwardRef(() => EnvironmentService))\n    private readonly environmentService: EnvironmentService\n  ) {}\n\n  async createComponents(\n    components: ComponentDto[],\n    environment: Environment,\n    queryRunner?: QueryRunner\n  ): Promise<Component[]> {\n    const componentsToSave = components.map((component) =>\n      this.componentRepository.create({ ...component, environment })\n    );\n\n    const savedComponents = queryRunner\n      ? await queryRunner.manager.save(Component, componentsToSave)\n      : await this.componentRepository.save(componentsToSave);\n\n    await Promise.all(\n      savedComponents.map((component) =>\n        this.createTaskForComponent(component, environment, undefined, queryRunner)\n      )\n    );\n\n    return savedComponents;\n  }\n\n  async createComponent(component: ComponentDto, environment_id: number) {\n    const environment = await this.environmentService.findById(environment_id);\n    return this.createComponents([component], environment);\n  }\n\n  private async createTaskForComponent(\n    component: Component,\n    environment: Environment,\n    dueDate?: Date,\n    queryRunner?: QueryRunner\n  ) {\n    await this.taskService.createTask<Component>(\n      component,\n      environment,\n      TaskTypes.MISSING_BACKUP,\n      dueDate,\n      queryRunner\n    );\n  }\n\n  async validateMinBackups(componentId: number | undefined) {\n    if (!componentId) {\n      throw new BadRequestException(`validateMinBackups - componentId is undefined`);\n    }\n    const component = await this.findById(componentId);\n    const backups = component.vps?.filter((vps) => vps.current_status === VpsStatus.BACKUP) ?? [];\n\n    if (component.min_backups <= backups.length) return;\n\n    const isTaskExists = component.tasks?.find(\n      (task) => task.type === TaskTypes.MISSING_BACKUP && task.status !== TaskProgressStatus.DONE\n    );\n\n    if (!isTaskExists) await this.createTaskForComponent(component, component.environment);\n  }\n\n  async findById(id: number): Promise<Component> {\n    const component = await this.componentRepository.findOne({\n      where: { id },\n      relations: ['vps', 'tasks', 'environment']\n    });\n    if (!component) {\n      Logger.error(`ComponentService: findById - Component with id: ${id} not found`);\n      throw new BadRequestException(`Component with id: ${id} not found`);\n    }\n    return component;\n  }\n\n  async attachProfileToComponent(\n    id: number,\n    profile: Profile,\n    queryRunner: QueryRunner\n  ): Promise<void> {\n    const component = await queryRunner.manager.findOne(Component, { where: { id } });\n    if (!component) {\n      Logger.error(`ComponentService - Component with ID ${id} not found`);\n      throw new BadRequestException(`Component with ID ${id} not found`);\n    }\n    await queryRunner.manager.save(Component, { id: component.id, profile });\n  }\n  async getComponentsByEnvId(environmentId: number) {\n    const components = await this.componentRepository.find({\n      where: { environment: { id: environmentId } },\n      relations: ['profile', 'environment']\n    });\n\n    if (components.length === 0) return [];\n\n    const productType = components[0].environment.type;\n    const names = components.map((c) => c.name);\n\n    const templates = await this.componentTemplateRepository.find({\n      where: {\n        name: In(names),\n        product_type: productType\n      }\n    });\n\n    const templateByName = new Map(templates.map((t) => [t.name, t]));\n\n    return components.map((c) => ({\n      id: c.id,\n      name: c.name,\n      positions: templateByName.get(c.name)?.positions ?? c.positions ?? []\n    }));\n  }\n  async getComponentsOrderByEnvType(environmentId: number) {\n    const components = await this.componentRepository.find({\n      where: { environment: { id: environmentId } },\n      relations: ['profile', 'environment', 'tasks']\n    });\n    const productType = components[0]?.environment.type;\n    const componentsOrder = getComponentsNameOrderByEnvType(productType);\n    const sortedComponents = components.sort((a, b) => {\n      const indexA = componentsOrder.get(a.name) ?? Infinity;\n      const indexB = componentsOrder.get(b.name) ?? Infinity;\n\n      if (indexA !== indexB) {\n        return indexA - indexB;\n      }\n      return a.name.localeCompare(b.name);\n    });\n    return sortedComponents;\n  }\n\n  async moveComponentsToEnvironment(componentIds: number[], environmentId: number) {\n    if (!componentIds?.length) {\n      Logger.error(`ComponentService - componentIds is required`);\n      throw new BadRequestException('componentIds is required');\n    }\n\n    return this.dataSource.transaction(async (manager) => {\n      const components = await manager.find(Component, {\n        where: { id: In(componentIds) },\n        relations: ['environment']\n      });\n      if (!components.length) {\n        Logger.error(`ComponentService - No components found for given ids`);\n        throw new BadRequestException('No components found for given ids');\n      }\n\n      const wj = components.find((cmp) => cmp.name === ComponentsNames.WHITE_JASMINO);\n      const nearOrFar = components.find(\n        (cmp) => cmp.name === ComponentsNames.FAR_ATTACKER || cmp.name === ComponentsNames.NEAR\n      );\n      const others = components.filter((cmp) => cmp.id !== wj?.id && cmp.id !== nearOrFar?.id);\n\n      if (wj) await moveWhiteJasmino(manager, environmentId);\n\n      if (nearOrFar) {\n        await moveNearOrFarComponent(manager, nearOrFar.id, environmentId);\n      }\n      if (others.length) {\n        const env = await manager.findOne(Environment, {\n          where: { id: environmentId }\n        });\n\n        if (!env) {\n          Logger.error(`ComponentService - Environment not found`);\n          throw new BadRequestException('Environment not found');\n        }\n\n        const now = new Date();\n\n        for (const cmp of components) {\n          cmp.environment = env;\n          cmp.last_moved_at = now;\n        }\n\n        await manager.save(components);\n      }\n    });\n  }\n}\n\n\n\n\nimport { Body, Controller, Get, Param, ParseIntPipe, Post, Put, Query } from '@nestjs\/common';\nimport { TaskService } from '.\/task.service';\nimport { UpdateTaskDto } from '.\/task.dto';\nimport { QueryDto } from 'apps\/core-service\/src\/query-builder\/query.dto';\nimport {\n  filterResponse,\n  TasksTabsTypes,\n  ITaskDetailsResponse,\n  ICalendarTaskResponse,\n  IResponse,\n  IRawResponseWalletsTask,\n  IRawResponseServersTask\n} from '@rubi\/types';\n\nimport { Task } from '.\/task.entity';\n\n@Controller('task')\nexport class TaskController {\n  constructor(private readonly taskService: TaskService) {}\n\n  @Get('all-cluster-names')\n  getAllClusterNames(): Promise<filterResponse[]> {\n    return this.taskService.getAllClusterNames();\n  }\n  @Get('\/filter-names\/:tabType')\n  getFilterNames(@Param('tabType') tabType: TasksTabsTypes): Promise<filterResponse[]> {\n    return this.taskService.getFilterNames(tabType);\n  }\n\n  @Put('\/:id')\n  updateTask(@Param('id', ParseIntPipe) id: number, @Body() body: UpdateTaskDto): Promise<Task> {\n    return this.taskService.updateTask(id, body);\n  }\n\n  @Get('\/:id')\n  getTaskDetails(@Param('id', ParseIntPipe) id: number): Promise<ITaskDetailsResponse | null> {\n    return this.taskService.getTaskDetails(id);\n  }\n\n  @Post('\/query\/wallets')\n  queryWalletsTasks(\n    @Body() body: QueryDto,\n    @Query('isClosed') isClosed: boolean\n  ): Promise<IResponse<IRawResponseWalletsTask>> {\n    return this.taskService.queryWalletsTasks(body, isClosed);\n  }\n\n  @Post('\/query\/servers')\n  queryServersTasks(\n    @Body() body: QueryDto,\n    @Query('isClosed') isClosed: boolean\n  ): Promise<IResponse<IRawResponseServersTask>> {\n    return this.taskService.queryServersTasks(body, isClosed);\n  }\n\n  @Post('\/query\/calendar')\n  queryTasksForCalendar(\n    @Body() body: QueryDto,\n    @Query('isClosed') isClosed: boolean\n  ): Promise<ICalendarTaskResponse> {\n    return this.taskService.getCalendarTasks(body, isClosed);\n  }\n\n  @Get('\/cluster-name\/:tabType')\n  getClusterNames(@Param('tabType') tabType: TasksTabsTypes): Promise<filterResponse[]> {\n    return this.taskService.getClustersNames(tabType);\n  }\n}\n\n\n\nimport { BadRequestException, Injectable, Logger } from '@nestjs\/common';\nimport { InjectRepository } from '@nestjs\/typeorm';\nimport { DataSource, In, Not, QueryRunner, Repository } from 'typeorm';\nimport { Task } from '.\/task.entity';\nimport {\n  calculateDaysLeft,\n  CheckList,\n  checklistByTaskType,\n  dueDateCase,\n  filterableServersTaskFields,\n  filterableWalletsTaskFields,\n  ICalendarTaskResponse,\n  IRawResponseServersTask,\n  IRawResponseWalletsTask,\n  IRawVps,\n  IResponse,\n  ITaskDetailsResponse,\n  LabelsData,\n  selectComponentId,\n  selectComponentName,\n  selectServersTasksQueryFields,\n  selectSubQueryServersTasksQueryFields,\n  selectSubQueryWalletsTasksQueryFields,\n  selectWalletsTasksQueryFields,\n  SortOrderEnum,\n  TaskFilterableFieldsEnum,\n  TaskProgressStatus,\n  TasksLabels,\n  TasksTabsTypes,\n  TaskTypes,\n  VpnStatus,\n  VpnType,\n  VpsStatus\n} from '@rubi\/types';\nimport { UpdateTaskDto } from '.\/task.dto';\nimport { Environment } from '..\/..\/environment-service\/environment\/environment.entity';\nimport { QueryBuilder } from 'apps\/core-service\/src\/query-builder\/query-builder';\nimport { QueryDto } from 'apps\/core-service\/src\/query-builder\/query.dto';\nimport { Vps } from '..\/..\/inventory-service\/vps\/vps.entity';\nimport { getCount } from 'apps\/core-service\/src\/utils\/getCount';\nimport { calculateDaysTimeDiff } from 'apps\/core-service\/src\/utils\/calculateTimeDiff';\nimport { endOfMonth, endOfWeek, startOfMonth, startOfWeek } from 'date-fns';\nimport dayjs from 'dayjs';\nimport { Vpn } from '..\/..\/inventory-service\/vpn\/vpn.entity';\n\n@Injectable()\nexport class TaskService {\n  constructor(\n    @InjectRepository(Task) private taskRepository: Repository<Task>,\n    private readonly dataSource: DataSource\n  ) {}\n\n  async createTask<T>(\n    relation: T,\n    environment: Environment | undefined,\n    taskType: TaskTypes,\n    dueDate?: Date,\n    queryRunner?: QueryRunner\n  ) {\n    const task = this.taskRepository.create({\n      [this.getRelationFieldByTaskType(taskType)]: relation,\n      environment,\n      type: taskType,\n      due_date: dueDate,\n      checklist: checklistByTaskType[taskType]\n    });\n\n    if (queryRunner) return queryRunner.manager.save(Task, task);\n\n    return this.taskRepository.save(task);\n  }\n\n  async updateVpsLastTask(vps: Vps) {\n    if (!vps.tasks) return;\n    const lastTask = vps.tasks[vps.tasks.length - 1];\n    lastTask.due_date = vps.expiry_date;\n    await this.updateTask(lastTask.id, lastTask);\n  }\n\n  async findOneById(id: number): Promise<Task> {\n    const task = await this.taskRepository.findOne({ where: { id } });\n    if (!task) {\n      Logger.error(`taskService: findById - task with id: ${id} not found`);\n      throw new BadRequestException(`task with id: ${id} not found`);\n    }\n    return task;\n  }\n\n  private getRelationFieldByTaskType(taskType: TaskTypes): keyof Task {\n    switch (taskType) {\n      case TaskTypes.MISSING_BACKUP:\n        return 'component';\n\n      case TaskTypes.RENEW_SERVER:\n      case TaskTypes.SERVER_NO_LONGER_IN_USE:\n      case TaskTypes.SERVER_UNDER_INSPECTION:\n        return 'vps';\n\n      case TaskTypes.EXPIRED_VPN:\n        return 'vpn';\n\n      case TaskTypes.WALLET_THRESHOLD:\n        return 'wallet';\n\n      default:\n        throw new Error(`Unknown task type: ${taskType}`);\n    }\n  }\n\n  async updateTask(id: number, body: UpdateTaskDto) {\n    Logger.log(`${TaskService.name} - updateTask with ID ${id} `);\n\n    if (body.checklist) {\n      const status = this.getStatusByChecklist(body.checklist);\n      return this.taskRepository.save({ id, ...body, status });\n    }\n\n    \/\/ Validating that due_date will not be updated if task is of type renew server\n    if (body.due_date) {\n      const task = await this.findOneById(id);\n      if (task.type === TaskTypes.RENEW_SERVER) delete body.due_date;\n    }\n\n    return this.taskRepository.save({ id, ...body });\n  }\n\n  private getStatusByChecklist(checkList: CheckList) {\n    const completedTasks = checkList.filter((task) => task.completed);\n\n    if (!completedTasks.length) return TaskProgressStatus.NEW;\n\n    if (completedTasks.length < checkList.length) return TaskProgressStatus.IN_PROGRESS;\n\n    return TaskProgressStatus.DONE;\n  }\n\n  async queryWalletsTasks(\n    query: QueryDto,\n    isClosed: boolean = false,\n    includeTotal: boolean = true\n  ): Promise<IResponse<IRawResponseWalletsTask>> {\n    const statusOperator = isClosed ? '=' : '!=';\n    const tasksQB = this.taskRepository\n      .createQueryBuilder('task')\n      .leftJoinAndSelect('task.wallet', 'wallet')\n      .leftJoinAndSelect('component', 'component', 'wallet.profileId=component.profileId')\n      .leftJoinAndSelect('task.environment', 'env')\n      .leftJoinAndSelect('env.owner', 'env_owner')\n      .where(`task.status ${statusOperator} :status`, { status: TaskProgressStatus.DONE })\n      .andWhere('task.type = :taskType', { taskType: TaskTypes.WALLET_THRESHOLD })\n      .select(selectWalletsTasksQueryFields)\n      .orderBy('task.due_date', SortOrderEnum.asc, 'NULLS LAST');\n\n    const queryBuilder = new QueryBuilder(tasksQB);\n    const tasksFilteredQuery = queryBuilder.applyQuery(query, filterableWalletsTaskFields);\n    const subQuery = tasksFilteredQuery.getQuery();\n    const baseQuery = this.dataSource\n      .createQueryBuilder()\n      .select(selectSubQueryWalletsTasksQueryFields)\n      .from(`(${subQuery})`, 'subquery')\n      .setParameters(tasksQB.getParameters());\n    const finalQueryBuilder = new QueryBuilder(baseQuery);\n    let total: number = 0;\n\n    if (includeTotal) {\n      total = await getCount(this.dataSource, tasksFilteredQuery);\n    }\n\n    const taskDataQuery = finalQueryBuilder.applyPagination(query);\n\n    const data = await taskDataQuery.getRawMany();\n\n    return { data, total };\n  }\n\n  private getVpnTaskComponent(vpn: Vpn) {\n    return vpn.vpnComponents?.find((vpnComponent) => vpnComponent.component)?.component;\n  }\n\n  private getVpnTaskEnvironment(vpn: Vpn) {\n    return vpn.environment ?? this.getVpnTaskComponent(vpn)?.environment;\n  }\n\n  private getVpnExpiryDate(vpn: Vpn): Date | undefined {\n    const expiryDate = (vpn.details as { expiry_date?: Date | string } | undefined)?.expiry_date;\n    return expiryDate ? new Date(expiryDate) : undefined;\n  }\n\n  private async syncExpiredVpnTasks(): Promise<void> {\n    const vpnRepository = this.dataSource.getRepository(Vpn);\n\n    const expiredVpns = await vpnRepository\n      .createQueryBuilder('vpn')\n      .leftJoinAndSelect('vpn.environment', 'environment')\n      .leftJoinAndSelect('vpn.vpnComponents', 'vpnComponents')\n      .leftJoinAndSelect('vpnComponents.component', 'component')\n      .leftJoinAndSelect('component.environment', 'componentEnvironment')\n      .where('vpn.status != :archivedStatus', { archivedStatus: VpnStatus.ARCHIVE })\n      .andWhere('vpn.type != :purchaserType', { purchaserType: VpnType.PURCHASER })\n      .andWhere(`vpn.details->>'expiry_date' IS NOT NULL`)\n      .andWhere(`vpn.details->>'expiry_date' != ''`)\n      .andWhere(`((vpn.details->>'expiry_date')::date - CURRENT_DATE) <= 5`)\n      .getMany();\n\n    const actionableExpiredVpns = expiredVpns.filter((vpn) => {\n      const environment = this.getVpnTaskEnvironment(vpn);\n\n      return Boolean(environment);\n    });\n\n    const actionableExpiredVpnIds = actionableExpiredVpns.map((vpn) => vpn.id);\n\n    if (!actionableExpiredVpns.length) return;\n\n    const existingTasks = await this.taskRepository.find({\n      where: {\n        type: TaskTypes.EXPIRED_VPN,\n        status: Not(TaskProgressStatus.DONE),\n        vpn: { id: In(actionableExpiredVpnIds) }\n      },\n      relations: ['vpn', 'environment', 'component']\n    });\n\n    const existingTasksByVpnId = new Map(\n      existingTasks.filter((task) => task.vpn?.id).map((task) => [task.vpn!.id, task])\n    );\n\n    const tasksToSave: Task[] = [];\n\n    actionableExpiredVpns.forEach((vpn) => {\n      const environment = this.getVpnTaskEnvironment(vpn);\n      const component = this.getVpnTaskComponent(vpn);\n      const dueDate = this.getVpnExpiryDate(vpn);\n      const existingTask = existingTasksByVpnId.get(vpn.id);\n\n      if (!environment || !dueDate) return;\n\n      if (existingTask) {\n        let shouldSave = false;\n\n        if (existingTask.environment?.id !== environment.id) {\n          existingTask.environment = environment;\n          shouldSave = true;\n        }\n\n        if (component && existingTask.component?.id !== component.id) {\n          existingTask.component = component;\n          shouldSave = true;\n        }\n\n        if (existingTask.due_date?.getTime() !== dueDate.getTime()) {\n          existingTask.due_date = dueDate;\n          shouldSave = true;\n        }\n\n        if (!component && existingTask.component) {\n          existingTask.component = undefined;\n          shouldSave = true;\n        }\n\n        if (shouldSave) {\n          tasksToSave.push(existingTask);\n        }\n\n        return;\n      }\n\n      tasksToSave.push(\n        this.taskRepository.create({\n          vpn,\n          environment,\n          ...(component && { component }),\n          type: TaskTypes.EXPIRED_VPN,\n          due_date: dueDate,\n          checklist: checklistByTaskType[TaskTypes.EXPIRED_VPN]\n        })\n      );\n    });\n\n    if (!tasksToSave.length) return;\n\n    await this.taskRepository.save(tasksToSave);\n  }\n\n  async queryServersTasks(\n    query: QueryDto,\n    isClosed: boolean = false,\n    includeTotal: boolean = true\n  ): Promise<IResponse<IRawResponseServersTask>> {\n    await this.syncExpiredVpnTasks();\n\n    const statusOperator = isClosed ? '=' : '!=';\n    const allTasksCondition = includeTotal ? 'AND' : 'OR';\n\n    const backupsCountSubQuery = this.dataSource\n      .createQueryBuilder()\n      .select('vps.\"componentId\"', 'component_id')\n      .addSelect('COUNT(*)', 'backups_count')\n      .from('vps', 'vps')\n      .where('vps.current_status = :vpsBackup', { vpsBackup: VpsStatus.BACKUP })\n      .groupBy('vps.\"componentId\"');\n\n    const tasksQB = this.taskRepository\n      .createQueryBuilder('task')\n      .leftJoinAndSelect('task.vps', 'task_vps')\n      .leftJoinAndSelect('task.vpn', 'task_vpn')\n      .leftJoinAndSelect('task.environment', 'env')\n      .leftJoinAndSelect('env.owner', 'env_owner')\n      .leftJoinAndSelect('task_vps.component', 'vps_component')\n      .leftJoinAndSelect('task.component', 'task_component')\n      .leftJoin(\n        '(' + backupsCountSubQuery.getQuery() + ')',\n        'backup_stats',\n        'backup_stats.component_id = task_component.id'\n      )\n      .where(`task.status ${statusOperator} :status`, { status: TaskProgressStatus.DONE })\n      .andWhere(\n        `((\"task\".\"type\" = 'renew_server' ${allTasksCondition} DATE_PART('day', \"task\".\"due_date\" - CURRENT_DATE) <= 5) OR (\"task\".\"type\" !=  'renew_server'))`\n      )\n      .andWhere('task.type != :taskType', { taskType: TaskTypes.WALLET_THRESHOLD })\n      .addSelect(selectServersTasksQueryFields)\n      .addSelect(selectComponentName, 'component_name')\n      .addSelect(selectComponentId, 'component_id')\n      .addSelect('COALESCE(backup_stats.backups_count, 0)', 'backups_count')\n      .setParameters(backupsCountSubQuery.getParameters());\n\n    !query.sort_by && tasksQB.orderBy('task.due_date', SortOrderEnum.asc, 'NULLS LAST');\n\n    if (query.sort_by === TaskFilterableFieldsEnum.DUE_DATE)\n      tasksQB.orderBy('task.due_date', SortOrderEnum.desc, 'NULLS LAST');\n\n    const queryBuilder = new QueryBuilder(tasksQB);\n    const tasksFilteredQuery = queryBuilder.applyQuery(query, filterableServersTaskFields);\n    const subQuery = tasksFilteredQuery.getQuery();\n\n    const baseQuery = this.dataSource\n      .createQueryBuilder()\n      .select(selectSubQueryServersTasksQueryFields)\n      .addSelect(calculateDaysLeft, 'days_left')\n      .addSelect(dueDateCase, 'due_date')\n      .from(`(${subQuery})`, 'subquery')\n      .setParameters(tasksQB.getParameters());\n\n    let total: number = 0;\n\n    if (includeTotal) {\n      total = await getCount(this.dataSource, tasksFilteredQuery);\n    }\n\n    const finalQueryBuilder = new QueryBuilder(baseQuery);\n    const taskDataQuery = finalQueryBuilder.applyPagination(query);\n\n    const data = await taskDataQuery.getRawMany();\n\n    return { data, total };\n  }\n\n  private calculateBackupsShortage(task: Task) {\n    const backups = task.component!.vps!.filter((vps) => vps.current_status === VpsStatus.BACKUP);\n    const minBackups = task.component!.min_backups;\n    const current_backups = backups.length;\n    const backups_shortage = minBackups - current_backups;\n    return { current_backups, backups_shortage };\n  }\n\n  async getTaskDetails(id: number) {\n    const task = await this.taskRepository.findOne({\n      where: { id },\n      relations: [\n        'environment',\n        'environment.owner',\n        'component',\n        'component.vps',\n        'wallet',\n        'vps',\n        'vps.vendor',\n        'vps.component',\n        'vps.moved_by',\n        'vpn',\n        'vpn.profile',\n        'vpn.profile.emails',\n        'vpn.attached_by',\n        'vpn.vpnComponents',\n        'vpn.vpnComponents.component',\n        'vpn.vpnComponents.component.environment'\n      ]\n    });\n\n    return this.parseTaskDetails(task);\n  }\n  private checkValidDateQueryCalendar(body: QueryDto): QueryDto {\n    if (!body.filter?.dateFilter || body.filter?.dateFilter.length === 0) {\n      return {\n        ...body,\n        filter: {\n          include: body.filter?.include ?? [],\n          exclude: body.filter?.exclude ?? [],\n          dateFilter: [\n            {\n              field: TaskFilterableFieldsEnum.DUE_DATE,\n              values: [startOfWeek(startOfMonth(new Date())), endOfWeek(endOfMonth(new Date()))]\n            }\n          ]\n        }\n      };\n    } else {\n      return body;\n    }\n  }\n\n  async getCalendarTasks(body: QueryDto, isClosed: boolean): Promise<ICalendarTaskResponse> {\n    let query: QueryDto = this.checkValidDateQueryCalendar(body);\n    const { data: serversTasks } = await this.queryServersTasks(query, isClosed, false);\n    const { data: walletsTasks } = await this.queryWalletsTasks(query, isClosed, false);\n\n    return [...serversTasks, ...walletsTasks];\n  }\n\n  private parseTaskDetails(task: Task | null) {\n    const parsedTask = {\n      ...task,\n      environment: task?.environment,\n      component: task?.component ?? task?.vps?.component,\n      vps: task?.vps ?? task?.component?.vps,\n      vpn: this.parseVpnTaskDetails(task?.vpn),\n      wallet: task?.wallet\n    };\n\n    if (task?.type === TaskTypes.RENEW_SERVER && task.due_date) {\n      const days_left = calculateDaysTimeDiff(task.due_date);\n      const due_date = dayjs(task.due_date).subtract(5, 'day').toDate();\n\n      \/\/ TODO:  check with spec if days can be positive to a limit\n      return { ...parsedTask, days_left, due_date } as unknown as ITaskDetailsResponse;\n    }\n\n    if (task?.type === TaskTypes.MISSING_BACKUP && task.component?.vps) {\n      const { current_backups, backups_shortage } = this.calculateBackupsShortage(task);\n      return {\n        ...parsedTask,\n        backups_shortage,\n        current_backups\n      } as unknown as ITaskDetailsResponse;\n    }\n\n    return parsedTask as unknown as ITaskDetailsResponse;\n  }\n\n  private parseVpnTaskDetails(vpn?: Vpn) {\n    if (!vpn) return undefined;\n\n    return {\n      ...vpn,\n      ...vpn.details,\n      attached_by: vpn.attached_by?.name,\n      attached_components:\n        vpn.vpnComponents?.map((vpnComponent) => ({\n          component_name: vpnComponent.component?.name,\n          component_id: vpnComponent.component?.id,\n          environment_name: vpnComponent.component?.environment?.name,\n          environment_id: vpnComponent.component?.environment?.id,\n          position: vpnComponent.position,\n          status: vpnComponent.status\n        })) ?? []\n    };\n  }\n\n  async getClustersNames(tabType: TasksTabsTypes) {\n    const typeOperator = tabType === TasksTabsTypes.WALLET ? '=' : '!=';\n\n    const tasksQB = this.taskRepository\n      .createQueryBuilder('task')\n      .leftJoinAndSelect('task.environment', 'environment')\n      .andWhere(`task.type ${typeOperator} :taskType`, { taskType: TaskTypes.WALLET_THRESHOLD })\n      .select(['environment.id as id', 'environment.name as name'])\n      .groupBy('environment.id');\n\n    return tasksQB.getRawMany();\n  }\n  async getFilterNames(tabType: TasksTabsTypes) {\n    switch (tabType) {\n      case TasksTabsTypes.SERVER:\n        return this.getComponentNames();\n      case TasksTabsTypes.WALLET:\n        return this.getWalletNames();\n      default:\n        return [];\n    }\n  }\n  async getComponentNames() {\n    const tasksQB = this.taskRepository\n      .createQueryBuilder('task')\n      .leftJoinAndSelect('task.component', 'component')\n      .andWhere(`task.type != :taskType`, { taskType: TaskTypes.WALLET_THRESHOLD })\n      .select(['component.id as id', 'component.name as name'])\n      .groupBy('component.id');\n\n    return tasksQB.getRawMany();\n  }\n  async getWalletNames() {\n    const tasksQB = this.taskRepository\n      .createQueryBuilder('task')\n      .leftJoinAndSelect('task.wallet', 'wallet')\n      .andWhere(`task.type = :taskType`, { taskType: TaskTypes.WALLET_THRESHOLD })\n      .select(['wallet.id as id', 'wallet.name as name'])\n      .groupBy('wallet.id');\n\n    return tasksQB.getRawMany();\n  }\n\n  async removeTasksByVpsId(vpsId: number): Promise<void> {\n    await this.taskRepository.delete({\n      vps: { id: vpsId }\n    });\n  }\n\n  createLabelsData(rawVps: IRawVps[]): LabelsData {\n    const labelsData: LabelsData = {\n      [TasksLabels.EXPIRED]: 0,\n      [TasksLabels.MISSING]: 0,\n      [TasksLabels.RECHARGE]: 0,\n      [TasksLabels.RENEWAL]: 0,\n      [TasksLabels.ROLLOVER]: 0\n    };\n\n    rawVps.map((vps) => {\n      if (vps.timer <= 5) labelsData[TasksLabels.ROLLOVER]++;\n      if (vps.task_label) labelsData[vps.task_label]++;\n    });\n\n    return labelsData;\n  }\n\n  getLabel(taskType: TaskTypes, due_date: Date | undefined): TasksLabels | undefined {\n    switch (taskType) {\n      case TaskTypes.WALLET_THRESHOLD:\n        return TasksLabels.RECHARGE;\n      case TaskTypes.MISSING_BACKUP:\n        return TasksLabels.MISSING;\n      case TaskTypes.RENEW_SERVER:\n        if (!due_date) return;\n        const daysLeft = calculateDaysTimeDiff(due_date);\n        if (daysLeft >= 0 && daysLeft <= 5) return TasksLabels.RENEWAL;\n        else if (daysLeft < 0) return TasksLabels.EXPIRED;\n        return;\n      default:\n        return;\n    }\n  }\n  async getAllClusterNames() {\n    const tasksQB = this.taskRepository\n      .createQueryBuilder('task')\n      .leftJoinAndSelect('task.environment', 'environment')\n      .select(['environment.id as id', 'environment.name as name'])\n      .groupBy('environment.id');\n\n    return tasksQB.getRawMany();\n  }\n}\n\n\n\n\nimport { IEnvironmentDetails, ProductTypeEnum } from '.\/environment.types';\nimport { IVpsDataResponse, VpsStatus } from '.\/server.types';\nimport { IComponentData } from '.\/types';\nimport { IAttachedComponent, IVpnDataById, VpnVendor } from '.\/vpn.types';\nimport { IWallet, WalletType } from '.\/wallet.types';\n\nexport enum TaskTypes {\n  WALLET_THRESHOLD = 'wallet_threshold',\n  RENEW_SERVER = 'renew_server',\n  MISSING_BACKUP = 'missing_backup',\n  SERVER_NO_LONGER_IN_USE = 'server_no_longer_in_use',\n  SERVER_UNDER_INSPECTION = 'server_under_inspection',\n  EXPIRED_VPN = 'expired_vpn'\n}\n\nexport enum TaskProgressStatus {\n  NEW = 'new',\n  IN_PROGRESS = 'in_progress',\n  DONE = 'done'\n}\n\nexport enum TaskPriority {\n  URGENT = 'urgent',\n  MEDIUM = 'medium',\n  LOW = 'low',\n  NORMAL = 'normal'\n}\n\nexport enum CheckListItemType {\n  VM = 'vm',\n  EXPENSE = 'expense',\n  SERVER = 'server',\n  INVOICE = 'invoice',\n  CHARGE = 'charge',\n  RENEW = 'renew',\n  INSPECTION = 'inspection',\n  ARCHIVE_VPN = 'archive_vpn'\n}\n\nexport interface CheckListItem {\n  title: string;\n  type: CheckListItemType;\n  completed: boolean;\n}\n\nexport type CheckList = CheckListItem[];\n\nexport const missingBackupServerChecklist: CheckListItem[] = [\n  {\n    title: 'Buy new server in VM',\n    type: CheckListItemType.VM,\n    completed: false\n  },\n  {\n    title: 'Add new expense',\n    type: CheckListItemType.EXPENSE,\n    completed: false\n  },\n  {\n    title: 'Add server details',\n    type: CheckListItemType.SERVER,\n    completed: false\n  },\n  {\n    title: 'Upload invoice',\n    type: CheckListItemType.INVOICE,\n    completed: false\n  }\n];\n\nexport const renewServerChecklist: CheckListItem[] = [\n  {\n    title: 'Renew subscription in VM',\n    type: CheckListItemType.VM,\n    completed: false\n  },\n  {\n    title: 'Update new expiry date',\n    type: CheckListItemType.RENEW,\n    completed: false\n  },\n  {\n    title: 'Add new expense',\n    type: CheckListItemType.EXPENSE,\n    completed: false\n  },\n  {\n    title: 'Upload invoice',\n    type: CheckListItemType.INVOICE,\n    completed: false\n  }\n];\n\nexport const serverNoLongerInUseChecklist: CheckListItem[] = [\n  {\n    title: 'Shut down and cancel supplier in VM',\n    type: CheckListItemType.VM,\n    completed: false\n  }\n];\n\nexport const serverUnderInspectionChecklist: CheckListItem[] = [\n  {\n    title: 'Fix issue in VM',\n    type: CheckListItemType.VM,\n    completed: false\n  },\n  {\n    title: 'Move server back to Backup or No longer in use',\n    type: CheckListItemType.INSPECTION,\n    completed: false\n  }\n];\n\nexport const walletThresholdChecklist: CheckListItem[] = [\n  {\n    title: 'Transfer money in VM',\n    type: CheckListItemType.VM,\n    completed: false\n  },\n  {\n    title: 'Charge wallet',\n    type: CheckListItemType.CHARGE,\n    completed: false\n  }\n];\n\nexport const expiredVpnChecklist: CheckListItem[] = [\n  {\n    title: 'Archive VPN',\n    type: CheckListItemType.ARCHIVE_VPN,\n    completed: false\n  }\n];\n\nexport type ChecklistByTaskType = Record<TaskTypes, CheckListItem[]>;\n\nexport const checklistByTaskType: ChecklistByTaskType = {\n  [TaskTypes.MISSING_BACKUP]: missingBackupServerChecklist,\n  [TaskTypes.RENEW_SERVER]: renewServerChecklist,\n  [TaskTypes.SERVER_NO_LONGER_IN_USE]: serverNoLongerInUseChecklist,\n  [TaskTypes.SERVER_UNDER_INSPECTION]: serverUnderInspectionChecklist,\n  [TaskTypes.WALLET_THRESHOLD]: walletThresholdChecklist,\n  [TaskTypes.EXPIRED_VPN]: expiredVpnChecklist\n};\n\nexport const calculateDaysLeft = `\n  CASE\n    WHEN subquery.type = '${TaskTypes.RENEW_SERVER}'\n    AND DATE_PART('day', subquery.due_date - CURRENT_DATE) <= 5\n    THEN DATE_PART('day', subquery.due_date - CURRENT_DATE)\n\n    WHEN subquery.type = '${TaskTypes.EXPIRED_VPN}'\n    THEN DATE_PART('day', subquery.due_date - CURRENT_DATE)\n\n    ELSE NULL\n  END\n`;\n\nexport const selectBaseTaskFields = [\n  'task.id as id',\n  'task.type as type',\n  'task.status as status',\n  'task.priority as priority',\n  'task.due_date as due_date',\n  'env.id as environment_id',\n  'env.name as environment_name',\n  'env.type as environment_type',\n  'env_owner.id as owner_id',\n  'env_owner.name as owner_name',\n  'env_owner.color as owner_color',\n  'env_owner.dark_color as owner_dark_color'\n];\n\nexport const selectBaseSubQueryTaskFields = [\n  'subquery.id as id',\n  'subquery.type as type',\n  'subquery.status as status',\n  'subquery.priority as priority',\n  'subquery.due_date as due_date',\n  'subquery.environment_id as environment_id',\n  'subquery.environment_name as environment_name',\n  'subquery.environment_type as environment_type',\n  'subquery.owner_id as owner_id',\n  'subquery.owner_name as owner_name',\n  'subquery.owner_color as owner_color',\n  'subquery.owner_dark_color as owner_dark_color'\n];\n\nexport const dueDateCase = `\n  CASE\n    WHEN subquery.type = '${TaskTypes.RENEW_SERVER}'\n    THEN subquery.due_date - INTERVAL '5 days'\n    ELSE subquery.due_date\n  END\n`;\n\nexport const selectWalletsTasksQueryFields = [\n  ...selectBaseTaskFields,\n  'wallet.id as wallet_id',\n  'wallet.dollar_balance as wallet_dollar_balance',\n  'wallet.name as wallet_name',\n  'wallet.type as wallet_type',\n  'wallet.threshold as wallet_threshold',\n  'component.name as component_name'\n];\n\nexport const selectServersTasksQueryFields = [\n  ...selectBaseTaskFields,\n  'task_vps.id as vps_id',\n  'task_vps.ip as vps_ip',\n  'task_vps.current_status as vps_current_status',\n  'task_vpn.id as vpn_id',\n  'task_vpn.define_role as vpn_define_role',\n  'task_vpn.vendor as vpn_vendor',\n  `(task_vpn.details->>'expiry_date')::timestamptz as vpn_expiry_date`,\n  'task_component.min_backups - COALESCE(backups_count, 0) as shortage'\n];\n\nexport interface filterResponse {\n  id: number;\n  name: string;\n}\n\nexport const selectSubQueryWalletsTasksQueryFields = [\n  ...selectBaseSubQueryTaskFields,\n  'subquery.wallet_id as wallet_id',\n  'subquery.wallet_dollar_balance as wallet_dollar_balance',\n  'subquery.wallet_name as wallet_name',\n  'subquery.component_name as component_name',\n  'subquery.wallet_type as wallet_type',\n  'subquery.wallet_threshold as wallet_threshold'\n];\n\nexport const selectSubQueryServersTasksQueryFields = [\n  ...selectBaseSubQueryTaskFields,\n  'subquery.component_id as component_id',\n  'subquery.component_name as component_name',\n  'subquery.vps_id as vps_id',\n  'subquery.vps_ip as vps_ip',\n  'subquery.vps_current_status as vps_current_status',\n  'subquery.vpn_id as vpn_id',\n  'subquery.vpn_define_role as vpn_define_role',\n  'subquery.vpn_vendor as vpn_vendor',\n  'subquery.vpn_expiry_date as vpn_expiry_date',\n  'subquery.shortage as backups_shortage'\n];\n\nexport const selectComponentName = `\nCASE\n    WHEN task_component.name IS NOT NULL THEN task_component.name\n    WHEN vps_component.name IS NOT NULL THEN vps_component.name\n    WHEN task_vpn.id IS NOT NULL THEN (\n      SELECT component.name\n      FROM vpn_component vc\n      JOIN component ON component.id = vc.component_id\n      WHERE vc.vpn_id = task_vpn.id\n      LIMIT 1\n    )\n    ELSE NULL\nEND`;\n\nexport const selectComponentId = `\nCASE\n    WHEN task_component.id IS NOT NULL THEN task_component.id\n    WHEN vps_component.id IS NOT NULL THEN vps_component.id\n    WHEN task_vpn.id IS NOT NULL THEN (\n      SELECT component.id\n      FROM vpn_component vc\n      JOIN component ON component.id = vc.component_id\n      WHERE vc.vpn_id = task_vpn.id\n      LIMIT 1\n    )\n    ELSE NULL\nEND`;\n\nexport enum TaskFilterableFieldsEnum {\n  STATUS = 'task.statu